module conductor_tests;

import ../lib/std std;

import ../lib/file_io file_io;
import ../lib/process process;
import ../src/ai_api;
import ../src/ai_tools;
import ../src/storage;

fn assert_true(ok: bool, name: str) -> i32 {
    if (!ok) {
        std.print("FAIL " + name);
        return 1;
    }
    std.print("PASS " + name);
    return 0;
}

fn main() -> i32 {
    let failures: i32 = 0;
    storage_set_home_override(file_io.path_join("/tmp", "conductor-tests-" + storage_new_session_id()));
    storage_env_set("CONDUCTOR_TEST_MODE", "0");
    storage_env_set("CONDUCTOR_OPENROUTER_TEST", "0");
    storage_env_set("OPENROUTER_MOCK", "0");
    storage_env_set("CONDUCTOR_OPENROUTER_LIVE", "0");
    storage_set_active_provider("deepseek");
    storage_set_active_model("deepseek/deepseek-v4-pro");
    failures = failures + assert_true(ai_provider_exists("openrouter-placeholder"), "default provider exists");
    failures = failures + assert_true(ai_model_count("deepseek") == 2, "default deepseek model count");
    failures = failures + assert_true(ai_openrouter_mode() == "test", "openrouter defaults to test mode");
    failures = failures + assert_true(ai_model_at("deepseek", 0) == "deepseek/deepseek-v4-pro", "default deepseek model is v4 pro");
    failures = failures + assert_true(storage_get_active_model() == "deepseek/deepseek-v4-pro", "active model default migrated");
    failures = failures + assert_true(std.contains(ai_placeholder_response("hello", "", ""), "hello"), "placeholder response echoes prompt");
    failures = failures + assert_true(std.contains(ai_openapi_placeholder(), "Conductor API"), "openapi placeholder title");
    failures = failures + assert_true(storage_permission_exists("bash"), "bash permission exists");
    failures = failures + assert_true(storage_permission_set("bash", "deny") == 0, "bash permission can be denied");
    failures = failures + assert_true(storage_permission_get("bash") == "deny", "bash permission persists");
    storage_permissions_reset();
    let agent_name: str = storage_new_session_id();
    failures = failures + assert_true(storage_create_agent(agent_name, "test desc", "all", "read") == 0, "agent create");
    failures = failures + assert_true(storage_set_active_agent(agent_name) == 0, "agent use");
    failures = failures + assert_true(storage_agent_exists("orchestrator"), "orchestrator seeded");
    failures = failures + assert_true(storage_agent_exists("designer"), "designer seeded");
    failures = failures + assert_true(storage_agent_exists("code_designer"), "code designer seeded");
    failures = failures + assert_true(storage_agent_exists("coder"), "coder seeded");
    failures = failures + assert_true(storage_agent_exists("reviewer"), "reviewer seeded");
    storage_context_clear();
    storage_context_append("spec", "keep this context");
    failures = failures + assert_true(std.contains(storage_context_get(), "keep this context"), "context persists");
    failures = failures + assert_true(std.contains(storage_status_text(), "provider=deepseek"), "status includes provider");

    // Session behavior tests
    let sid1: str = storage_create_session("test-session-1");
    failures = failures + assert_true(std.len(std.trim(sid1)) > 0, "session created on startup");
    let active: str = storage_get_active_session();
    failures = failures + assert_true(active == sid1, "active session set after create");
    let rec: str = storage_record_session("title", "hello", "world");
    failures = failures + assert_true(rec == sid1, "recording uses active session");
    // create an empty session and then restore first session
    let sid2: str = storage_create_session("empty-session");
    failures = failures + assert_true(std.len(std.trim(sid2)) > 0, "empty session created");
    let _rc: i32 = storage_set_active_session(sid1);
    // cleanup should remove the empty session
    storage_cleanup_sessions();
    let del_rc: i32 = storage_delete_session(sid2);
    failures = failures + assert_true(del_rc == 1, "cleanup removed empty session");

    // Providers tests: create provider backed by file and mock run
    let keypath: str = file_io.path_join(storage_providers_dir(), "key-mock.txt");
    file_io.write_file(keypath, "MOCK");
    if (storage_provider_exists("openrouter-test")) { storage_provider_delete("openrouter-test"); }
    let p_rc: i32 = storage_provider_create("openrouter-test", "openrouter", "file:" + keypath);
    failures = failures + assert_true((p_rc == 0) || (p_rc == 2), "provider create file scheme");
    let got: str = provider_get_api_key("openrouter-test");
    failures = failures + assert_true(std.len(std.trim(got)) > 0, "provider_get_api_key returns value");
    let use_rc: i32 = storage_set_active_provider("openrouter-test");
    failures = failures + assert_true(use_rc == 0, "set active provider");
    failures = failures + assert_true(storage_get_active_provider() == "openrouter-test", "active provider set");
    let run_out: str = ai_run("hello world", "", "openrouter-test");
    std.print("AI RUN OUT: " + run_out);
    failures = failures + assert_true(std.contains(run_out, "mocked"), "ai_run returns mocked response when key is MOCK");
    let safe_out: str = ai_run("no credits please", "", "openrouter");
    failures = failures + assert_true(std.contains(safe_out, "credits=0"), "default openrouter run avoids network credits");
    failures = failures + assert_true(std.contains(ai_openrouter_provider_body("deepseek"), "\"only\":[\"deepseek\"]"), "deepseek provider routes only to official provider");
    failures = failures + assert_true(std.contains(ai_openrouter_provider_body("deepseek"), "\"allow_fallbacks\":false"), "deepseek provider disables fallbacks");
    failures = failures + assert_true(ai_openrouter_extract_content("{\"choices\":[{\"message\":{\"content\":\"hello\\nworld\"}}]}") == "hello\nworld", "openrouter content extraction handles escapes");
    failures = failures + assert_true(std.contains(ai_openrouter_extract_content("{\"choices\":[{\"finish_reason\":\"length\",\"message\":{\"content\":null}}]}"), "no assistant content"), "openrouter null content returns clear error");
    storage_env_set("CONDUCTOR_OPENROUTER_MAX_TOKENS", "99999");
    failures = failures + assert_true(ai_openrouter_max_tokens() == 8192, "openrouter max tokens capped");
    storage_env_set("CONDUCTOR_OPENROUTER_LIVE", "1");
    failures = failures + assert_true(ai_openrouter_mode() == "live", "stored live flag enables live mode");
    storage_env_set("CONDUCTOR_OPENROUTER_TEST", "1");
    failures = failures + assert_true(ai_openrouter_mode() == "test", "stored test flag overrides live mode");

    // Basic ai_tools test: run a bash command (uses global default allow)
    storage_permission_set("bash", "allow");
    let tool_out: str = ai_execute_tool("bash", "echo tool_test");
    failures = failures + assert_true(std.contains(tool_out, "tool_test"), "ai_execute_tool bash works");

    // Skills, MCP registry, role context, and event ledger tests
    let skill_name: str = "skill-" + storage_new_session_id();
    let skill_content: str = "---\nname: " + skill_name + "\ndescription: test skill\n---\nUse terse test output.\n";
    failures = failures + assert_true(storage_skill_register(skill_name, "test skill", "/tmp/SKILL.md", skill_content) == 0, "skill register");
    failures = failures + assert_true(std.contains(storage_skill_list(), skill_name), "skill list includes registered skill");
    failures = failures + assert_true(std.contains(storage_enabled_skills_context(), "Use terse test output"), "enabled skill context includes body");
    failures = failures + assert_true(storage_skill_set_enabled(skill_name, false) == 0, "skill disable");
    failures = failures + assert_true(!std.contains(storage_enabled_skills_context(), "Use terse test output"), "disabled skill omitted from context");

    let mcp_name: str = "mcp-" + storage_new_session_id();
    failures = failures + assert_true(storage_mcp_server_create(mcp_name, "python3 scripts/fake_mcp_server.py") == 0, "mcp server create");
    failures = failures + assert_true(std.contains(storage_mcp_server_list(), mcp_name), "mcp server list");
    failures = failures + assert_true(std.contains(storage_mcp_server_get(mcp_name), "fake_mcp_server.py"), "mcp server get");
    let http_mcp_name: str = "http-mcp-" + storage_new_session_id();
    failures = failures + assert_true(storage_mcp_server_create_transport(http_mcp_name, "http", "", "http://127.0.0.1:39087/mcp") == 0, "http mcp server create");
    failures = failures + assert_true(std.contains(storage_mcp_server_get(http_mcp_name), "transport=streamable-http"), "http mcp transport normalized");
    failures = failures + assert_true(std.contains(storage_mcp_server_list(), "127.0.0.1:39087"), "http mcp server list includes url");

    let sid3: str = storage_create_session("ledger-session");
    let original_id: str = storage_record_event(sid3, "original_prompt", "user", "compact test prompt");
    let ev_id: str = storage_record_event(sid3, "decision", "orchestrator", "keep evidence");
    failures = failures + assert_true(storage_event_exists(sid3, ev_id), "event exists");
    storage_role_append(sid3, "coder", "note", "role-local memory");
    storage_role_append(sid3, "code_designer", "note", "design role-local memory");
    failures = failures + assert_true(std.contains(storage_role_context_get(sid3, "coder"), "role-local memory"), "role context persists");
    failures = failures + assert_true(std.contains(storage_role_context_get(sid3, "code_designer"), "design role-local memory"), "code designer context persists");
    failures = failures + assert_true(storage_session_context_chars(sid3) >= std.len(storage_role_context_get(sid3, "code_designer")), "code designer context counted");
    failures = failures + assert_true(storage_compaction_create(sid3, "reviewer", "compact test prompt " + ev_id) == 1, "non-orchestrator compaction denied");
    failures = failures + assert_true(storage_compaction_create(sid3, "orchestrator", "missing prompt " + ev_id) == 3, "compaction requires prompt excerpt");
    failures = failures + assert_true(storage_compaction_create(sid3, "orchestrator", "compact test prompt missing-event") == 4, "compaction requires real event id");
    failures = failures + assert_true(storage_compaction_create(sid3, "orchestrator", "compact test prompt " + ev_id) == 0, "compaction saves with evidence");
    storage_env_set("CONDUCTOR_COMPACT_AFTER_CHARS", "1");
    failures = failures + assert_true(storage_auto_compact_if_needed(sid3) == 0, "auto compaction saves when threshold reached");

    if (failures == 0) {
        std.print("All Conductor Novus tests passed.");
        return 0;
    }
    std.print("Conductor tests failed: " + std.to_str(failures));
    return 1;
}
