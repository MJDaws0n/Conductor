module conductor_ai_api;

import ../lib/std std;
import ../lib/env env;
import ../lib/process process;
import ../lib/file_io file_io;
import storage;

fn ai_default_provider() -> str {
    return "deepseek";
}

fn ai_default_model() -> str {
    return storage_get_active_model();
}

fn ai_truthy(value: str) -> bool {
    let v: str = std.lower(std.trim(value));
    if (v == "1" || v == "true" || v == "yes" || v == "on" || v == "live") { return true; }
    return false;
}

fn ai_json_escape(value: str) -> str {
    let out: str = std.replace(value, "\\", "\\\\");
    out = std.replace(out, "\"", "\\\"");
    out = std.replace(out, "\r", "\\r");
    out = std.replace(out, "\n", "\\n");
    out = std.replace(out, "\t", "\\t");
    return out;
}

fn ai_json_unescape(value: str) -> str {
    let out: str = std.replace(value, "\\n", "\n");
    out = std.replace(out, "\\r", "\r");
    out = std.replace(out, "\\t", "\t");
    out = std.replace(out, "\\\"", "\"");
    out = std.replace(out, "\\\\", "\\");
    return out;
}

fn ai_openrouter_mock_forced() -> bool {
    if (ai_truthy(storage_env_get("CONDUCTOR_TEST_MODE"))) { return true; }
    if (ai_truthy(storage_process_env_get("CONDUCTOR_TEST_MODE"))) { return true; }
    if (ai_truthy(storage_env_get("CONDUCTOR_OPENROUTER_TEST"))) { return true; }
    if (ai_truthy(storage_process_env_get("CONDUCTOR_OPENROUTER_TEST"))) { return true; }
    if (ai_truthy(storage_env_get("OPENROUTER_MOCK"))) { return true; }
    if (ai_truthy(storage_process_env_get("OPENROUTER_MOCK"))) { return true; }
    return false;
}

fn ai_openrouter_live_enabled() -> bool {
    if (ai_openrouter_mock_forced()) { return false; }
    if (ai_truthy(storage_env_get("CONDUCTOR_OPENROUTER_LIVE"))) { return true; }
    if (ai_truthy(storage_process_env_get("CONDUCTOR_OPENROUTER_LIVE"))) { return true; }
    if (ai_truthy(storage_env_get("OPENROUTER_LIVE"))) { return true; }
    if (ai_truthy(storage_process_env_get("OPENROUTER_LIVE"))) { return true; }
    return false;
}

fn ai_openrouter_mode() -> str {
    if (ai_openrouter_live_enabled()) { return "live"; }
    return "test";
}

fn ai_openrouter_model_name(model: str) -> str {
    if (std.starts_with(model, "openrouter/")) { return std.substr(model, 11); }
    if (std.starts_with(model, "openrouter-placeholder/")) { return "deepseek/deepseek-v4-pro"; }
    return model;
}

fn ai_openrouter_mock_response(prompt: str, model: str, provider: str) -> str {
    let preview: str = prompt;
    if (std.len(preview) > 1200) {
        preview = std.substr_len(preview, 0, 1200) + "\n[truncated test prompt chars=" + std.to_str(std.len(prompt)) + "]";
    }
    return "Conductor OpenRouter test response (mocked=true, network=false, credits=0)\nprovider=" + provider + "\nmodel=" + model + "\nPrompt received: " + preview;
}

fn ai_print_providers() -> void {
    storage_init();
    let list: str = storage_provider_list();
    std.print(list);
}

fn ai_provider_exists(provider: str) -> bool {
    storage_init();
    if (provider == "openrouter-placeholder") { return true; }
    if (provider == "openrouter") { return true; }
    if (provider == "deepseek") { return true; }
    return storage_provider_exists(provider);
}

fn ai_model_count(provider: str) -> i32 {
    // Accept legacy provider name
    if (provider == "openrouter-placeholder") { provider = "openrouter"; }
    if (provider == "deepseek") { return 2; }
    // Static OpenRouter presets keep listing local and credit-free.
    if (provider == "openrouter") { return 4; }
    let kind: str = std.lower(ai_provider_config_value(provider, "kind"));
    if (kind == "openrouter") { return 4; }
    if (provider == "local") { return 2; }
    return 0;
}

fn ai_model_at(provider: str, index: i32) -> str {
    if (provider == "openrouter-placeholder") { provider = "openrouter"; }
    if (provider == "deepseek") {
        if (index == 0) { return "deepseek/deepseek-v4-pro"; }
        if (index == 1) { return "deepseek/deepseek-v4-flash"; }
        return "";
    }
    let kind: str = std.lower(ai_provider_config_value(provider, "kind"));
    if (kind == "openrouter") { provider = "openrouter"; }
    if (provider == "openrouter") {
        if (index == 0) { return "openrouter/deepseek/deepseek-v4-pro"; }
        if (index == 1) { return "openrouter/deepseek/deepseek-v4-flash"; }
        if (index == 2) { return "openrouter/openai/gpt-4o-mini"; }
        if (index == 3) { return "openrouter/anthropic/claude-3.5-sonnet"; }
        return "";
    }
    if (provider == "local") {
        if (index == 0) { return "local/conductor-fast"; }
        if (index == 1) { return "local/conductor-deep"; }
        return "";
    }
    return "";
}

fn provider_get_api_key(provider: str) -> str {
    storage_init();
    let cfg: str = storage_provider_get(provider);
    if (std.len(std.trim(cfg)) == 0) { return ""; }
    // parse connection line
    let conn_line: str = "";
    let rest: str = cfg;
    while (std.len(std.trim(rest)) > 0) {
        let line: str = std.split_first(rest, "\n");
        rest = std.split_rest(rest, "\n");
        if (std.starts_with(line, "connection=")) { conn_line = std.trim(std.substr(line, 11)); break; }
    }
    if (std.len(std.trim(conn_line)) == 0) { return ""; }
    if (std.starts_with(conn_line, "env:")) {
        let var: str = std.trim(std.substr(conn_line, 4));
        let s: str = storage_env_get(var);
        if (std.len(std.trim(s)) > 0) { return std.trim(s); }
        return std.trim(storage_process_env_get(var));
    }
    if (std.starts_with(conn_line, "file:")) {
        let path: str = std.trim(std.substr(conn_line, 5));
        return std.trim(file_io.read_file(path));
    }
    if (std.starts_with(conn_line, "keyring:")) {
        let keyname: str = std.trim(std.substr(conn_line, 8));
        // Try Linux secret-tool (libsecret)
        let st: str = std.trim(process.shell_output("which secret-tool 2>/dev/null || true", 65536));
        if (std.len(st) > 0) {
            let cmd: str = "secret-tool lookup conductor " + keyname;
            let val: str = process.shell_output(cmd, 65536);
            if (std.len(std.trim(val)) > 0) { return std.trim(val); }
        }
        // Try macOS security CLI
        let sec: str = std.trim(process.shell_output("which security 2>/dev/null || true", 65536));
        if (std.len(sec) > 0) {
            let cmd2: str = "security find-generic-password -s conductor -a " + keyname + " -w 2>/dev/null || true";
            let val2: str = process.shell_output(cmd2, 65536);
            if (std.len(std.trim(val2)) > 0) { return std.trim(val2); }
        }
        // Not found in keyring; fallthrough to other schemes
    }
    if (std.starts_with(conn_line, "gpg:")) {
        // decrypt using gpg -- assumes user has keys or symmetric passphrase access
        let path: str = std.trim(std.substr(conn_line, 4));
        let cmd: str = "gpg --batch --yes --quiet --decrypt '" + path + "'";
        let dec: str = process.shell_output(cmd, 65536);
        return std.trim(dec);
    }
    // unknown scheme - return raw
    return conn_line;
}

fn ai_provider_config_value(provider: str, field: str) -> str {
    let cfg: str = storage_provider_get(provider);
    let rest: str = cfg;
    let prefix: str = field + "=";
    while (std.len(std.trim(rest)) > 0) {
        let line: str = std.trim(std.split_first(rest, "\n"));
        rest = std.split_rest(rest, "\n");
        if (std.starts_with(line, prefix)) { return std.trim(std.substr(line, std.len(prefix))); }
    }
    return "";
}

fn ai_provider_uses_openrouter(provider: str) -> bool {
    if (provider == "openrouter" || provider == "openrouter-placeholder" || provider == "deepseek") { return true; }
    let kind: str = std.lower(ai_provider_config_value(provider, "kind"));
    if (kind == "openrouter") { return true; }
    return false;
}

fn ai_openrouter_provider_body(provider: str) -> str {
    let only: str = ai_provider_config_value(provider, "provider_only");
    if (std.len(std.trim(only)) == 0 && provider == "deepseek") { only = "deepseek"; }
    if (std.len(std.trim(only)) > 0) {
        return ",\"provider\":{\"only\":[\"" + ai_json_escape(std.trim(only)) + "\"],\"allow_fallbacks\":false}";
    }
    return "";
}

fn ai_openrouter_max_tokens() -> i32 {
    let raw: str = storage_env_get("CONDUCTOR_OPENROUTER_MAX_TOKENS");
    if (std.len(std.trim(raw)) == 0) { raw = storage_process_env_get("CONDUCTOR_OPENROUTER_MAX_TOKENS"); }
    if (std.len(std.trim(raw)) == 0) { return 2048; }
    let n: i32 = std.to_i32(std.trim(raw));
    if (n <= 0) { return 2048; }
    if (n > 8192) { return 8192; }
    return n;
}

fn ai_openrouter_reasoning_body(provider: str) -> str {
    let effort: str = storage_env_get("CONDUCTOR_OPENROUTER_REASONING_EFFORT");
    if (std.len(std.trim(effort)) == 0) { effort = storage_process_env_get("CONDUCTOR_OPENROUTER_REASONING_EFFORT"); }
    if (std.len(std.trim(effort)) == 0) { effort = "minimal"; }
    let include_raw: str = storage_env_get("CONDUCTOR_OPENROUTER_INCLUDE_REASONING");
    let include_reasoning: bool = ai_truthy(include_raw);
    let exclude: str = "true";
    if (include_reasoning) { exclude = "false"; }
    return ",\"reasoning\":{\"effort\":\"" + ai_json_escape(std.trim(effort)) + "\",\"exclude\":" + exclude + "}";
}

fn ai_shell_quote(value: str) -> str {
    return "'" + std.replace(value, "'", "'\"'\"'") + "'";
}

fn ai_curl_config_escape(value: str) -> str {
    let out: str = std.replace(value, "\\", "\\\\");
    out = std.replace(out, "\"", "\\\"");
    out = std.replace(out, "\r", "\\r");
    out = std.replace(out, "\n", "\\n");
    return out;
}

fn ai_shell_output_full(cmd: str, max_len: i32) -> str {
    let sh: str = "/bin/sh";
    let flag: str = "-c";
    let av: []u64 = [ptr(sh), ptr(flag), ptr(cmd), 0];
    return process.capture_output_full(sh, av, max_len);
}

fn ai_openrouter_payload(prompt: str, model: str, provider: str, stream: bool) -> str {
    let safe_input: str = ai_json_escape(prompt);
    let max_tokens: i32 = ai_openrouter_max_tokens();
    let stream_flag: str = "false";
    if (stream) { stream_flag = "true"; }
    return "{\"model\":\"" + model + "\",\"messages\":[{\"role\":\"user\",\"content\":\"" + safe_input + "\"}],\"stream\":" + stream_flag + ",\"max_tokens\":" + std.to_str(max_tokens) + ",\"temperature\":0.2" + ai_openrouter_reasoning_body(provider) + ai_openrouter_provider_body(provider) + "}";
}

fn ai_openrouter_key(provider: str) -> str {
    let key: str = provider_get_api_key(provider);
    if (std.len(std.trim(key)) == 0) {
        key = storage_env_get("OPENROUTER_API_KEY");
        if (std.len(std.trim(key)) == 0) { key = storage_process_env_get("OPENROUTER_API_KEY"); }
    }
    return std.trim(key);
}

fn ai_openrouter_request(prompt: str, model: str, provider: str) -> str {
    if (std.len(std.trim(model)) == 0) { model = ai_model_at("openrouter", 0); }
    model = ai_openrouter_model_name(model);

    if (!ai_openrouter_live_enabled()) {
        return ai_openrouter_mock_response(prompt, model, provider);
    }

    let key: str = ai_openrouter_key(provider);
    if (std.len(std.trim(key)) == 0) {
        return "Error: OPENROUTER_API_KEY not set (or provider connection).";
    }

    // treat key value "MOCK" as a mock trigger
    let ktrim: str = std.trim(key);
    if (std.len(ktrim) > 0) {
        if (std.lower(ktrim) == "mock") {
            return ai_openrouter_mock_response(prompt, model, provider);
        }
    }

    let url: str = "https://openrouter.ai/api/v1/chat/completions";
    let payload: str = ai_openrouter_payload(prompt, model, provider, false);
    let tmp_dir: str = file_io.path_join(storage_root(), "tmp");
    file_io.mkdirp(tmp_dir);
    let req_id: str = storage_new_session_id();
    let payload_path: str = file_io.path_join(tmp_dir, req_id + ".json");
    let config_path: str = file_io.path_join(tmp_dir, req_id + ".curl");
    let body_path: str = file_io.path_join(tmp_dir, req_id + ".out");
    file_io.write_file(payload_path, payload);
    let config: str = "request = \"POST\"\nurl = \"" + ai_curl_config_escape(url) + "\"\nheader = \"Authorization: Bearer " + ai_curl_config_escape(key) + "\"\nheader = \"Content-Type: application/json\"\nheader = \"HTTP-Referer: https://github.com/MJDaws0n/Conductor\"\nheader = \"X-Title: Conductor\"\ndata = \"@" + ai_curl_config_escape(payload_path) + "\"\nmax-time = 45\nsilent\nshow-error\n";
    file_io.write_file(config_path, config);
    let cmd: str = "curl -K " + ai_shell_quote(config_path) + " -o " + ai_shell_quote(body_path) + " -w " + ai_shell_quote("%{http_code}");
    let code_out: str = std.trim(ai_shell_output_full(cmd, 4096));
    let body: str = "";
    if (file_io.file_exists(body_path)) { body = file_io.read_file(body_path); }
    file_io.file_delete(config_path);
    file_io.file_delete(payload_path);
    if (file_io.file_exists(body_path)) { file_io.file_delete(body_path); }

    let http_code: i32 = std.to_i32(code_out);
    if (http_code == 0) { return "Error: OpenRouter request failed before HTTP response: " + body; }
    if (http_code >= 200 && http_code < 300) {
        return ai_openrouter_extract_content(body);
    }
    return "Error: HTTP " + std.to_str(http_code) + " - " + body;
}

fn ai_openrouter_request_stream(prompt: str, model: str, provider: str) -> str {
    if (std.len(std.trim(model)) == 0) { model = ai_model_at(provider, 0); }
    if (std.len(std.trim(model)) == 0) { model = ai_model_at("deepseek", 0); }
    model = ai_openrouter_model_name(model);

    if (!ai_openrouter_live_enabled()) {
        let mock: str = ai_openrouter_mock_response(prompt, model, provider);
        std.print(mock);
        return mock;
    }

    let key: str = ai_openrouter_key(provider);
    if (std.len(std.trim(key)) == 0) {
        let err: str = "Error: OPENROUTER_API_KEY not set (or provider connection).";
        std.print(err);
        return err;
    }
    if (std.lower(std.trim(key)) == "mock") {
        let mock2: str = ai_openrouter_mock_response(prompt, model, provider);
        std.print(mock2);
        return mock2;
    }

    let tmp_dir: str = file_io.path_join(storage_root(), "tmp");
    file_io.mkdirp(tmp_dir);
    let req_id: str = storage_new_session_id();
    let payload_path: str = file_io.path_join(tmp_dir, req_id + ".stream.json");
    let key_path: str = file_io.path_join(tmp_dir, req_id + ".key");
    let out_path: str = file_io.path_join(tmp_dir, req_id + ".stream.out");
    file_io.write_file(payload_path, ai_openrouter_payload(prompt, model, provider, true));
    file_io.write_file(key_path, key);

    let helper: str = "scripts/openrouter_stream.py";
    let cmd: str = "python3 " + ai_shell_quote(helper) + " --payload " + ai_shell_quote(payload_path) + " --key-file " + ai_shell_quote(key_path) + " --out " + ai_shell_quote(out_path);
    let rc: i32 = process.shell_exec(cmd);
    let response: str = "";
    if (file_io.file_exists(out_path)) { response = file_io.read_file(out_path); }
    file_io.file_delete(payload_path);
    file_io.file_delete(key_path);
    if (file_io.file_exists(out_path)) { file_io.file_delete(out_path); }
    if (rc != 0 && std.len(std.trim(response)) == 0) {
        return "Error: OpenRouter streaming request failed.";
    }
    return std.trim(response);
}

fn ai_openrouter_extract_content(body: str) -> str {
    let finish_reason: str = ai_json_extract_string_field(body, "finish_reason");
    let marker: str = "\"content\"";
    let pos: i32 = std.find(body, marker);
    if (pos < 0) { return body; }
    let after: str = std.substr(body, pos + std.len(marker));
    let value: str = std.trim(std.split_rest(after, ":"));
    if (!std.starts_with(value, "\"")) {
        if (std.starts_with(value, "null")) {
            return "Error: OpenRouter returned no assistant content (finish_reason=" + finish_reason + "). Increase CONDUCTOR_OPENROUTER_MAX_TOKENS or lower CONDUCTOR_OPENROUTER_REASONING_EFFORT.";
        }
        return body;
    }
    let raw: str = "";
    let escaped: bool = false;
    let i: i32 = 1;
    while (i < std.len(value)) {
        if (escaped) {
            raw = raw + "\\" + value[i];
            escaped = false;
        } else if (value[i] == '\\') {
            escaped = true;
        } else if (value[i] == '"') {
            return std.trim(ai_json_unescape(raw));
        } else {
            raw = raw + value[i];
        }
        i = i + 1;
    }
    return body;
}

fn ai_json_extract_string_field(body: str, field: str) -> str {
    let marker: str = "\"" + field + "\"";
    let pos: i32 = std.find(body, marker);
    if (pos < 0) { return ""; }
    let after: str = std.substr(body, pos + std.len(marker));
    let value: str = std.trim(std.split_rest(after, ":"));
    if (!std.starts_with(value, "\"")) { return ""; }
    let raw: str = "";
    let escaped: bool = false;
    let i: i32 = 1;
    while (i < std.len(value)) {
        if (escaped) {
            raw = raw + "\\" + value[i];
            escaped = false;
        } else if (value[i] == '\\') {
            escaped = true;
        } else if (value[i] == '"') {
            return ai_json_unescape(raw);
        } else {
            raw = raw + value[i];
        }
        i = i + 1;
    }
    return "";
}

fn ai_run(prompt: str, model: str, provider: str) -> str {
    if (std.len(std.trim(provider)) == 0) { provider = ai_default_provider(); }
    if (ai_provider_uses_openrouter(provider)) {
        if (std.len(std.trim(model)) == 0) { model = ai_model_at(provider, 0); }
        if (std.len(std.trim(model)) == 0) { model = ai_model_at("deepseek", 0); }
        return ai_openrouter_request(prompt, model, provider);
    }
    return ai_placeholder_response(prompt, model, "");
}

fn ai_run_stream(prompt: str, model: str, provider: str) -> str {
    if (std.len(std.trim(provider)) == 0) { provider = ai_default_provider(); }
    if (ai_provider_uses_openrouter(provider)) {
        return ai_openrouter_request_stream(prompt, model, provider);
    }
    let fallback: str = ai_placeholder_response(prompt, model, "");
    std.print(fallback);
    return fallback;
}

fn ai_placeholder_response(prompt: str, model: str, agent: str) -> str {
    return "Placeholder AI response from " + model + " using agent '" + agent + "'. Prompt received: " + prompt;
}

fn ai_print_models(provider: str, verbose: bool) -> i32 {
    if (std.len(std.trim(provider)) == 0) { provider = ai_default_provider(); }
    if (ai_provider_uses_openrouter(provider)) {
        let count: i32 = ai_model_count(provider);
        if (count == 0) { return 1; }
        let i: i32 = 0;
        while (i < count) {
            std.print(std.to_str(i) + ". " + ai_model_at(provider, i));
            i = i + 1;
        }
        return 0;
    }
    // fallback
    std.print("No models for provider: " + provider);
    return 1;
}

fn ai_openapi_placeholder() -> str {
    return "{\n  \"openapi\": \"3.1.0\",\n  \"info\": { \"title\": \"Conductor API\", \"version\": \"0.1.0\" },\n  \"paths\": {\n    \"/ai/run\": { \"post\": { \"summary\": \"AI run endpoint\" } },\n    \"/models\": { \"get\": { \"summary\": \"List models\" } },\n    \"/providers\": { \"get\": { \"summary\": \"List providers\" } }\n  }\n}";
}
