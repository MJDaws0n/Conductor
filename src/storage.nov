module conductor_storage;

import ../lib/std std;
import ../lib/file_io file_io;
import ../lib/env env;
import ../lib/time time;

fn storage_home_override_path() -> str {
    return ".conductor-home-" + std.to_str(env.getpid());
}

fn storage_set_home_override(path: str) -> void {
    let clean: str = std.trim(path);
    if (std.len(clean) == 0) {
        if (file_io.file_exists(storage_home_override_path())) {
            file_io.file_delete(storage_home_override_path());
        }
        return;
    }
    file_io.write_file(storage_home_override_path(), clean);
}

fn storage_process_env_get(name: str) -> str {
    return std.trim(env.getenv(name));
}

fn storage_root() -> str {
    if (file_io.file_exists(storage_home_override_path())) {
        let override_path: str = std.trim(file_io.read_file(storage_home_override_path()));
        if (std.len(override_path) > 0) { return override_path; }
    }
    let configured: str = storage_process_env_get("CONDUCTOR_HOME");
    if (std.len(configured) > 0) {
        return configured;
    }
    return ".conductor";
}

fn storage_sessions_dir() -> str {
    return file_io.path_join(storage_root(), "sessions");
}

fn storage_config_path() -> str {
    return file_io.path_join(storage_root(), "config.txt");
}

fn storage_session_index_path() -> str {
    return file_io.path_join(storage_root(), "sessions.txt");
}

fn storage_stats_path() -> str {
    return file_io.path_join(storage_root(), "stats.txt");
}

fn storage_agents_dir() -> str {
    return file_io.path_join(storage_root(), "agents");
}

fn storage_agents_index_path() -> str {
    return file_io.path_join(storage_agents_dir(), "index.txt");
}

fn storage_active_agent_path() -> str {
    return file_io.path_join(storage_root(), "active-agent.txt");
}

fn storage_active_model_path() -> str {
    return file_io.path_join(storage_root(), "active-model.txt");
}

fn storage_env_path() -> str {
    return file_io.path_join(storage_root(), "env.txt");
}

fn storage_context_path() -> str {
    return file_io.path_join(storage_root(), "context.txt");
}

fn storage_skills_dir() -> str {
    return file_io.path_join(storage_root(), "skills");
}

fn storage_skill_index_path() -> str {
    return file_io.path_join(storage_skills_dir(), "index.txt");
}

fn storage_skill_path(name: str) -> str {
    return file_io.path_join(storage_skills_dir(), name + ".txt");
}

fn storage_mcp_dir() -> str {
    return file_io.path_join(storage_root(), "mcp");
}

fn storage_mcp_servers_dir() -> str {
    return file_io.path_join(storage_mcp_dir(), "servers");
}

fn storage_mcp_server_index_path() -> str {
    return file_io.path_join(storage_mcp_dir(), "servers.txt");
}

fn storage_mcp_server_path(name: str) -> str {
    return file_io.path_join(storage_mcp_servers_dir(), name + ".txt");
}

fn storage_session_data_dir(session_id: str) -> str {
    return file_io.path_join(storage_sessions_dir(), session_id);
}

fn storage_session_roles_dir(session_id: str) -> str {
    return file_io.path_join(storage_session_data_dir(session_id), "roles");
}

fn storage_session_compactions_dir(session_id: str) -> str {
    return file_io.path_join(storage_session_data_dir(session_id), "compactions");
}

fn storage_session_events_path(session_id: str) -> str {
    return file_io.path_join(storage_session_data_dir(session_id), "events.txt");
}

fn storage_role_context_path(session_id: str, role: str) -> str {
    return file_io.path_join(storage_session_roles_dir(session_id), role + ".txt");
}

fn storage_escape_line(value: str) -> str {
    let out: str = std.replace(value, "\\", "\\\\");
    out = std.replace(out, "\t", "\\t");
    out = std.replace(out, "\r", "\\r");
    out = std.replace(out, "\n", "\\n");
    return out;
}

fn storage_unescape_line(value: str) -> str {
    let out: str = std.replace(value, "\\n", "\n");
    out = std.replace(out, "\\r", "\r");
    out = std.replace(out, "\\t", "\t");
    out = std.replace(out, "\\\\", "\\");
    return out;
}

fn storage_field_value(content: str, field: str) -> str {
    let prefix: str = field + "=";
    let rest: str = content;
    while (std.len(std.trim(rest)) > 0) {
        let line: str = std.split_first(rest, "\n");
        rest = std.split_rest(rest, "\n");
        if (std.starts_with(line, prefix)) {
            return storage_unescape_line(std.trim(std.substr(line, std.len(prefix))));
        }
    }
    return "";
}

fn storage_event_value(line: str, field: str) -> str {
    let marker: str = field + "=";
    if (!std.contains(line, marker)) { return ""; }
    let after: str = std.split_rest(line, marker);
    let value: str = std.split_first(after, "\t");
    return storage_unescape_line(std.trim(value));
}

fn storage_env_get(name: str) -> str {
    storage_init();
    let path: str = storage_env_path();
    if (!file_io.file_exists(path)) { return ""; }
    let content: str = file_io.read_file(path);
    let rest: str = content;
    while (std.len(std.trim(rest)) > 0) {
        let line: str = std.split_first(rest, "\n");
        rest = std.split_rest(rest, "\n");
        let ltrim: str = std.trim(line);
        if (std.len(ltrim) == 0) { continue; }
        if (std.starts_with(ltrim, "#")) { continue; }
        if (std.contains(ltrim, "=")) {
            let k: str = std.trim(std.split_first(ltrim, "="));
            let v: str = std.trim(std.split_rest(ltrim, "="));
            if (k == name) { return v; }
        }
    }
    return "";
}

fn storage_env_set(name: str, value: str) -> void {
    storage_init();
    let path: str = storage_env_path();
    let content: str = "";
    if (file_io.file_exists(path)) {
        content = file_io.read_file(path);
    }
    let rest: str = content;
    let out: str = "";
    let found: bool = false;
    while (std.len(std.trim(rest)) > 0) {
        let line: str = std.split_first(rest, "\n");
        rest = std.split_rest(rest, "\n");
        let ltrim: str = std.trim(line);
        if (std.len(ltrim) == 0) { out = out + line + "\n"; continue; }
        if (std.starts_with(ltrim, "#")) { out = out + line + "\n"; continue; }
        if (std.contains(ltrim, "=")) {
            let k: str = std.trim(std.split_first(ltrim, "="));
            if (k == name) {
                out = out + name + "=" + value + "\n";
                found = true;
            } else {
                out = out + ltrim + "\n";
            }
        } else {
            out = out + ltrim + "\n";
        }
    }
    if (!found) {
        out = out + name + "=" + value + "\n";
    }
    file_io.write_file(path, out);
}

fn storage_env_list() -> str {
    storage_init();
    let path: str = storage_env_path();
    if (!file_io.file_exists(path)) { return ""; }
    return file_io.read_file(path);
}

fn storage_permissions_dir() -> str {
    return file_io.path_join(storage_root(), "permissions");
}

fn storage_permission_path(tool: str) -> str {
    return file_io.path_join(storage_permissions_dir(), tool + ".txt");
}

fn storage_init() -> void {
    file_io.mkdirp(storage_root());
    file_io.mkdirp(storage_sessions_dir());
    file_io.mkdirp(storage_agents_dir());
    file_io.mkdirp(storage_permissions_dir());
    file_io.mkdirp(storage_skills_dir());
    file_io.mkdirp(storage_mcp_dir());
    file_io.mkdirp(storage_mcp_servers_dir());
    if (!file_io.file_exists(storage_config_path())) {
        file_io.write_file(storage_config_path(), "provider=deepseek\nmodel=deepseek/deepseek-v4-pro\n");
    }
    if (!file_io.file_exists(storage_session_index_path())) {
        file_io.write_file(storage_session_index_path(), "");
    }
    if (!file_io.file_exists(storage_stats_path())) {
        file_io.write_file(storage_stats_path(), "runs=0\n");
    }
    if (!file_io.file_exists(storage_active_agent_path())) {
        file_io.write_file(storage_active_agent_path(), "conductor-agent");
    }
    if (!file_io.file_exists(storage_active_model_path())) {
        file_io.write_file(storage_active_model_path(), "deepseek/deepseek-v4-pro");
    }
    if (!file_io.file_exists(storage_agents_index_path())) {
        file_io.write_file(storage_agents_index_path(), "conductor-agent | all | Default terminal coding agent\n");
    }
    if (!file_io.file_exists(storage_skill_index_path())) {
        file_io.write_file(storage_skill_index_path(), "");
    }
    if (!file_io.file_exists(storage_mcp_server_index_path())) {
        file_io.write_file(storage_mcp_server_index_path(), "");
    }
    let default_agent_path: str = file_io.path_join(storage_agents_dir(), "conductor-agent.txt");
    if (!file_io.file_exists(default_agent_path)) {
        file_io.write_file(default_agent_path, "name=conductor-agent\ndescription=Default terminal coding agent\nmode=all\npermissions=read,edit,glob,grep,bash,webfetch,task,mcp\nsystem_prompt=You are Conductor, a terminal-first coding agent wrapper operating inside the user's target workspace. Plan briefly, edit the target project carefully, run checks, and keep tool use within configured permissions. Never treat Conductor itself as the application unless the user explicitly asks to work on Conductor.\n");
    }
    storage_seed_agent("orchestrator", "Plans tasks, chooses next specialist, and decides when work is complete", "plan", "read,glob,grep,task,mcp", "Maintain global task state, break work into small steps, choose designer/coder/reviewer handoffs, and stop when acceptance criteria are met.");
    storage_seed_agent("designer", "Turns plans into concrete file-level implementation steps", "design", "read,glob,grep", "Convert goals into architecture notes, target files, interfaces, and patch outlines. Do not write final code.");
    storage_seed_agent("code_designer", "Turns orchestrator goals into concrete file-level implementation contracts", "design", "read,glob,grep,mcp", "Convert goals into architecture notes, target files, interfaces, and acceptance checks. Hand implementation work to coder through orchestrator-mediated dispatch.");
    storage_seed_agent("coder", "Applies small focused code changes from a design", "code", "read,edit,write,glob,grep,bash", "Implement scoped changes, preserve local style, avoid unrelated edits, and return concise implementation notes.");
    storage_seed_agent("reviewer", "Runs checks and reports defects or approval", "review", "read,glob,grep,bash", "Run relevant tests or static checks, identify regressions, and report clear pass/fail feedback.");
    // Ensure env store exists
    let env_path: str = storage_env_path();
    if (!file_io.file_exists(env_path)) { file_io.write_file(env_path, ""); }
    if (!file_io.file_exists(storage_context_path())) { file_io.write_file(storage_context_path(), ""); }

    storage_permissions_bootstrap();
    // Ensure providers exist and set default active provider if missing
    storage_providers_init();
    if (!file_io.file_exists(storage_active_provider_path())) {
        file_io.write_file(storage_active_provider_path(), "deepseek");
    }
    storage_migrate_defaults();
}

fn storage_migrate_defaults() -> void {
    if (file_io.file_exists(storage_active_model_path())) {
        let active_model: str = std.trim(file_io.read_file(storage_active_model_path()));
        if (active_model == "openrouter-placeholder/conductor-dev") {
            file_io.write_file(storage_active_model_path(), "deepseek/deepseek-v4-pro");
        }
        if (active_model == "openrouter/deepseek/deepseek-chat") {
            file_io.write_file(storage_active_model_path(), "deepseek/deepseek-v4-pro");
        }
    }
    if (file_io.file_exists(storage_active_provider_path())) {
        let active_provider: str = std.trim(file_io.read_file(storage_active_provider_path()));
        if (active_provider == "openrouter-placeholder") {
            file_io.write_file(storage_active_provider_path(), "deepseek");
        }
    }
    if (file_io.file_exists(storage_config_path())) {
        let cfg: str = file_io.read_file(storage_config_path());
        if (std.contains(cfg, "openrouter-placeholder/conductor-dev")) {
            file_io.write_file(storage_config_path(), "provider=deepseek\nmodel=deepseek/deepseek-v4-pro\n");
        }
        if (std.contains(cfg, "openrouter/deepseek/deepseek-chat")) {
            file_io.write_file(storage_config_path(), "provider=deepseek\nmodel=deepseek/deepseek-v4-pro\n");
        }
    }
    let default_agent_path: str = file_io.path_join(storage_agents_dir(), "conductor-agent.txt");
    if (file_io.file_exists(default_agent_path)) {
        let agent_cfg: str = file_io.read_file(default_agent_path);
        if (std.contains(agent_cfg, "system_prompt=You are Conductor, a terminal-first coding agent. Plan briefly, edit carefully, run checks, and keep tool use within configured permissions.")) {
            file_io.write_file(default_agent_path, "name=conductor-agent\ndescription=Default terminal coding agent\nmode=all\npermissions=read,edit,glob,grep,bash,webfetch,task,mcp\nsystem_prompt=You are Conductor, a terminal-first coding agent wrapper operating inside the user's target workspace. Plan briefly, edit the target project carefully, run checks, and keep tool use within configured permissions. Never treat Conductor itself as the application unless the user explicitly asks to work on Conductor.\n");
        }
    }
}

fn storage_seed_agent(name: str, desc: str, mode: str, perms: str, prompt: str) -> void {
    let path: str = storage_agent_path(name);
    if (!file_io.file_exists(path)) {
        file_io.write_file(path, "name=" + name + "\ndescription=" + desc + "\nmode=" + mode + "\npermissions=" + perms + "\nsystem_prompt=" + prompt + "\n");
    }
    let index_path: str = storage_agents_index_path();
    let index: str = "";
    if (file_io.file_exists(index_path)) { index = file_io.read_file(index_path); }
    if (!std.contains(index, name + " |")) {
        file_io.file_append(index_path, name + " | " + mode + " | " + desc + "\n");
    }
}

fn storage_new_session_id() -> str {
    let t: i64 = time.get_time_ms();
    return "session-" + std.to_str(t);
}

fn storage_active_session_path() -> str {
    return file_io.path_join(storage_root(), "active-session.txt");
}

fn storage_get_active_session() -> str {
    storage_init();
    if (!file_io.file_exists(storage_active_session_path())) {
        return "";
    }
    return std.trim(file_io.read_file(storage_active_session_path()));
}

fn storage_set_active_session(id: str) -> i32 {
    storage_init();
    let path: str = file_io.path_join(storage_sessions_dir(), id + ".txt");
    if (!file_io.file_exists(path)) {
        return 1;
    }
    file_io.write_file(storage_active_session_path(), id);
    return 0;
}

fn storage_session_exists(id: str) -> bool {
    storage_init();
    let path: str = file_io.path_join(storage_sessions_dir(), id + ".txt");
    return file_io.file_exists(path);
}

fn storage_create_session(title: str) -> str {
    storage_init();
    let id: str = storage_new_session_id();
    let file_name: str = id + ".txt";
    let path: str = file_io.path_join(storage_sessions_dir(), file_name);
    let t: i64 = time.get_time_ms();
    let body: str = "id=" + id + "\n";
    body = body + "title=" + title + "\n";
    body = body + "created_at=" + std.to_str(t) + "\n";
    file_io.write_file(path, body);
    file_io.file_append(storage_session_index_path(), id + " | " + title + "\n");
    file_io.write_file(storage_active_session_path(), id);
    storage_session_bootstrap(id);
    return id;
}

fn storage_append_message(session_id: str, role: str, content: str) -> void {
    storage_init();
    let path: str = file_io.path_join(storage_sessions_dir(), session_id + ".txt");
    if (!file_io.file_exists(path)) { return; }
    let t: i64 = time.get_time_ms();
    file_io.file_append(path, "===MSG_START===\nrole=" + role + "\ntimestamp=" + std.to_str(t) + "\ncontent=\n" + content + "\n===MSG_END===\n");
}

fn storage_message_role(block: str) -> str {
    return storage_field_value(block, "role");
}

fn storage_message_content(block: str) -> str {
    let marker: str = "content=\n";
    let pos: i32 = std.find(block, marker);
    if (pos < 0) { return ""; }
    return std.trim(std.substr(block, pos + std.len(marker)));
}

fn storage_message_display_role(role: str) -> str {
    if (role == "user") { return "You"; }
    if (role == "assistant") { return "Conductor"; }
    if (role == "tool") { return "Tool"; }
    if (role == "user-continuation") { return "You"; }
    return role;
}

fn storage_session_message_count(id: str) -> i32 {
    storage_init();
    let path: str = file_io.path_join(storage_sessions_dir(), id + ".txt");
    if (!file_io.file_exists(path)) { return 0; }
    let content: str = file_io.read_file(path);
    let rest: str = content;
    let count: i32 = 0;
    while (std.contains(rest, "===MSG_START===")) {
        let after: str = std.split_rest(rest, "===MSG_START===");
        if (!std.contains(after, "===MSG_END===")) { return count; }
        count = count + 1;
        rest = std.split_rest(after, "===MSG_END===");
    }
    return count;
}

fn storage_print_session_history(id: str, max_messages: i32) -> i32 {
    storage_init();
    let path: str = file_io.path_join(storage_sessions_dir(), id + ".txt");
    if (!file_io.file_exists(path)) { return 1; }
    let content: str = file_io.read_file(path);
    let total: i32 = storage_session_message_count(id);
    let start_at: i32 = 0;
    if (max_messages > 0 && total > max_messages) { start_at = total - max_messages; }
    let rest: str = content;
    let idx: i32 = 0;
    let printed: i32 = 0;
    if (total > 0) {
        std.print("");
        if (start_at > 0) {
            std.print("Recent history (last " + std.to_str(max_messages) + " messages)");
        } else {
            std.print("Chat history");
        }
        std.print("------------");
    }
    while (std.contains(rest, "===MSG_START===")) {
        let after: str = std.split_rest(rest, "===MSG_START===");
        if (!std.contains(after, "===MSG_END===")) { return 0; }
        let block: str = std.split_first(after, "===MSG_END===");
        rest = std.split_rest(after, "===MSG_END===");
        if (idx >= start_at) {
            let role: str = storage_message_display_role(storage_message_role(block));
            let body: str = storage_message_content(block);
            if (std.len(std.trim(body)) > 0) {
                std.print(role + ": " + body);
                printed = printed + 1;
            }
        }
        idx = idx + 1;
    }
    if (printed == 0) {
        std.print("");
        std.print("No chat history yet.");
    }
    return 0;
}

fn storage_last_session() -> str {
    storage_init();
    let idx: str = file_io.read_file(storage_session_index_path());
    let rest: str = idx;
    let last_id: str = "";
    while (std.len(std.trim(rest)) > 0) {
        let line: str = std.split_first(rest, "\n");
        rest = std.split_rest(rest, "\n");
        let ltrim: str = std.trim(line);
        if (std.len(ltrim) > 0) {
            last_id = std.trim(std.split_first(ltrim, "|"));
        }
    }
    return last_id;
}

fn storage_cleanup_sessions() -> void {
    storage_init();
    let idx: str = file_io.read_file(storage_session_index_path());
    let rest: str = idx;
    let new_index: str = "";
    while (std.len(std.trim(rest)) > 0) {
        let line: str = std.split_first(rest, "\n");
        rest = std.split_rest(rest, "\n");
        let line_trim: str = std.trim(line);
        if (std.len(line_trim) == 0) { continue; }
        let id: str = std.trim(std.split_first(line_trim, "|"));
        let path: str = file_io.path_join(storage_sessions_dir(), id + ".txt");
        if (!file_io.file_exists(path)) {
            // skip missing files
        } else {
            let content: str = file_io.read_file(path);
            if (std.contains(content, "===MSG_START===")) {
                new_index = new_index + id + " | " + std.trim(std.split_rest(line_trim, "|")) + "\n";
            } else {
                file_io.file_delete(path);
            }
        }
    }
    file_io.write_file(storage_session_index_path(), new_index);
    let active: str = storage_get_active_session();
    if (std.len(std.trim(active)) > 0) {
        let active_path: str = file_io.path_join(storage_sessions_dir(), active + ".txt");
        if (!file_io.file_exists(active_path)) {
            if (file_io.file_exists(storage_active_session_path())) {
                file_io.file_delete(storage_active_session_path());
            }
        }
    }
}

fn storage_increment_runs() -> void {
    let content: str = file_io.read_file(storage_stats_path());
    let count: i32 = 0;
    if (std.starts_with(content, "runs=")) {
        count = std.to_i32(std.substr(content, 5));
    }
    count = count + 1;
    file_io.write_file(storage_stats_path(), "runs=" + std.to_str(count) + "\n");
}

fn storage_record_session(title: str, prompt: str, response: str) -> str {
    storage_init();
    let id: str = storage_get_active_session();
    if (std.len(std.trim(id)) == 0) {
        id = storage_create_session(title);
    }
    storage_append_message(id, "user", prompt);
    storage_append_message(id, "assistant", response);
    storage_increment_runs();
    return id;
}

fn storage_print_sessions() -> void {
    storage_init();
    let index: str = file_io.read_file(storage_session_index_path());
    if (std.len(std.trim(index)) == 0) {
        std.print("No sessions yet.");
        return;
    }
    std.print(index);
}

fn storage_delete_session(id: str) -> i32 {
    storage_init();
    let path: str = file_io.path_join(storage_sessions_dir(), id + ".txt");
    if (!file_io.file_exists(path)) {
        let idx_content: str = file_io.read_file(storage_session_index_path());
        let rest: str = idx_content;
        let new_index: str = "";
        while (std.len(std.trim(rest)) > 0) {
            let line: str = std.split_first(rest, "\n");
            rest = std.split_rest(rest, "\n");
            let lt: str = std.trim(line);
            if (std.len(lt) == 0) { continue; }
            let curid: str = std.trim(std.split_first(lt, "|"));
            if (curid != id) {
                new_index = new_index + lt + "\n";
            }
        }
        file_io.write_file(storage_session_index_path(), new_index);
        return 1;
    }
    file_io.file_delete(path);
    let idx_content: str = file_io.read_file(storage_session_index_path());
    let rest: str = idx_content;
    let new_index: str = "";
    while (std.len(std.trim(rest)) > 0) {
        let line: str = std.split_first(rest, "\n");
        rest = std.split_rest(rest, "\n");
        let lt: str = std.trim(line);
        if (std.len(lt) == 0) { continue; }
        let curid: str = std.trim(std.split_first(lt, "|"));
        if (curid != id) {
            new_index = new_index + lt + "\n";
        }
    }
    file_io.write_file(storage_session_index_path(), new_index);
    if (storage_get_active_session() == id) {
        if (file_io.file_exists(storage_active_session_path())) {
            file_io.file_delete(storage_active_session_path());
        }
    }
    return 0;
}

fn storage_print_config() -> void {
    storage_init();
    std.print(file_io.read_file(storage_config_path()));
}

fn storage_config_check() -> i32 {
    storage_init();
    let cfg: str = file_io.read_file(storage_config_path());
    if (!std.contains(cfg, "provider=")) {
        return 1;
    }
    if (!std.contains(cfg, "model=")) {
        return 1;
    }
    return 0;
}

fn storage_print_stats() -> void {
