    return std.trim(file_io.read_file(storage_active_agent_path()));
}

fn storage_get_active_model() -> str {
    storage_init();
    return std.trim(file_io.read_file(storage_active_model_path()));
}

fn storage_context_get() -> str {
    storage_init();
    if (!file_io.file_exists(storage_context_path())) { return ""; }
    return file_io.read_file(storage_context_path());
}

fn storage_context_append(label: str, content: str) -> void {
    storage_init();
    let clean_label: str = std.trim(label);
    if (std.len(clean_label) == 0) { clean_label = "note"; }
    file_io.file_append(storage_context_path(), "## " + clean_label + "\n" + content + "\n\n");
}

fn storage_context_clear() -> void {
    storage_init();
    file_io.write_file(storage_context_path(), "");
