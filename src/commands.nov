module conductor_commands;

import ../lib/std std;
import ../lib/file_io file_io;
import ../lib/env env;
import ../lib/process process;
import ../lib/time time;

import ui;
import storage;
import ai_api;
import ai_tools;

fn arg_at(argv: u64, index: i32) -> str {
    return std.argv_get(argv, index);
}

fn has_arg(argc: i32, argv: u64, name: str) -> bool {
    let i: i32 = 1;
    while (i < argc) {
        if (arg_at(argv, i) == name) { return true; }
        i = i + 1;
    }
    return false;
}

fn option_value(argc: i32, argv: u64, name: str, fallback: str) -> str {
    let i: i32 = 1;
    while (i < argc - 1) {
        if (arg_at(argv, i) == name) {
            return arg_at(argv, i + 1);
        }
        i = i + 1;
    }
    return fallback;
}

fn collect_message(argc: i32, argv: u64, start: i32) -> str {
    let out: str = "";
    let i: i32 = start;
    while (i < argc) {
        let a: str = arg_at(argv, i);
        if (std.starts_with(a, "--")) {
            i = i + 2;
        } else {
            if (std.len(out) > 0) { out = out + " "; }
            out = out + a;
            i = i + 1;
        }
    }
    return out;
}

fn shell_quote(value: str) -> str {
    return "'" + std.replace(value, "'", "'\"'\"'") + "'";
}

fn script_path(name: str) -> str {
    let local: str = "scripts/" + name;
    if (file_io.file_exists(local)) { return local; }
    return local;
}

fn strip_wrapping_quotes(value: str) -> str {
    let v: str = std.trim(value);
    if (std.starts_with(v, "\"")) {
        let inner: str = std.substr(v, 1);
        let end_pos: i32 = std.find(inner, "\"");
        if (end_pos >= 0) { return std.substr_len(inner, 0, end_pos); }
    }
    return v;
}

fn parse_field(content: str, field: str) -> str {
    let prefix: str = field + ":";
    let rest: str = content;
    while (std.len(std.trim(rest)) > 0) {
        let line: str = std.trim(std.split_first(rest, "\n"));
        rest = std.split_rest(rest, "\n");
        if (std.starts_with(line, prefix)) {
            let value: str = strip_wrapping_quotes(std.substr(line, std.len(prefix)));
            if (value == ">" || value == "|") {
                let folded: str = "";
                let more: str = rest;
                while (std.len(std.trim(more)) > 0) {
                    let next_line: str = std.split_first(more, "\n");
                    more = std.split_rest(more, "\n");
                    let trimmed_next: str = std.trim(next_line);
                    if (std.starts_with(trimmed_next, "---")) { return folded; }
                    if (std.starts_with(next_line, " ") || std.starts_with(next_line, "\t")) {
                        if (std.len(folded) > 0) { folded = folded + " "; }
                        folded = folded + trimmed_next;
                    } else {
                        return folded;
                    }
                }
                return folded;
            }
            return value;
        }
    }
    return "";
}

fn codex_home_default() -> str {
    let out: str = std.trim(process.shell_output("printf '%s' \"${CODEX_HOME:-$HOME/.codex}\"", 4096));
    if (std.len(out) > 0) { return out; }
    return ".codex";
}

fn toml_unquote(value: str) -> str {
    let v: str = std.trim(value);
    if (std.starts_with(v, "\"")) {
        let inner: str = std.substr(v, 1);
        let end_pos: i32 = std.find(inner, "\"");
        if (end_pos >= 0) {
            let raw: str = std.substr_len(inner, 0, end_pos);
            return std.replace(std.replace(std.replace(raw, "\\n", "\n"), "\\t", "\t"), "\\\"", "\"");
        }
    }
    return strip_wrapping_quotes(v);
}

fn toml_array_to_args(value: str) -> str {
    let v: str = std.trim(value);
    if (!std.starts_with(v, "[")) { return ""; }
    let inner: str = std.substr(v, 1);
    let close_pos: i32 = std.find(inner, "]");
    if (close_pos >= 0) { inner = std.substr_len(inner, 0, close_pos); }
    let rest: str = inner;
    let out: str = "";
    while (std.len(std.trim(rest)) > 0) {
        let item: str = std.trim(std.split_first(rest, ","));
        rest = std.split_rest(rest, ",");
        if (std.len(item) > 0) {
            let arg: str = toml_unquote(item);
            if (std.len(std.trim(arg)) > 0) {
                if (std.len(out) > 0) { out = out + " "; }
                out = out + shell_quote(arg);
            }
        }
        if (!std.contains(rest, ",")) {
            let last: str = std.trim(rest);
            if (std.len(last) > 0) {
                let arg2: str = toml_unquote(last);
                if (std.len(std.trim(arg2)) > 0) {
                    if (std.len(out) > 0) { out = out + " "; }
                    out = out + shell_quote(arg2);
                }
            }
            rest = "";
        }
    }
    return out;
}

fn skill_name_from_path(path: str) -> str {
    let parent: str = file_io.path_basename(file_io.path_dir(path));
    if (std.len(std.trim(parent)) > 0) { return parent; }
    return file_io.path_stem(file_io.path_basename(path));
}

fn import_skill_file(path: str) -> i32 {
    if (!file_io.file_exists(path)) { return 1; }
    let content: str = file_io.read_file(path);
    let name: str = parse_field(content, "name");
    if (std.len(std.trim(name)) == 0) { name = skill_name_from_path(path); }
    let desc: str = parse_field(content, "description");
    return storage_skill_register(name, desc, path, content);
}

fn import_codex_skills(skills_dir: str) -> str {
    storage_init();
    let list_path: str = file_io.path_join(storage_root(), "codex-skill-import-files.txt");
    let cmd: str = "find " + shell_quote(skills_dir) + " -maxdepth 4 -name SKILL.md -type f > " + shell_quote(list_path) + " 2>/dev/null";
    process.shell_exec(cmd);
    let files: str = "";
    if (file_io.file_exists(list_path)) { files = file_io.read_file(list_path); }
    let rest: str = files;
    let added: i32 = 0;
    let skipped: i32 = 0;
    let missing: i32 = 0;
    while (std.len(std.trim(rest)) > 0) {
        let path: str = std.trim(std.split_first(rest, "\n"));
        rest = std.split_rest(rest, "\n");
        if (std.len(path) == 0) { continue; }
        let rc: i32 = import_skill_file(path);
        if (rc == 0) { added = added + 1; }
        else if (rc == 2) { skipped = skipped + 1; }
        else { missing = missing + 1; }
    }
    return "skills imported: added=" + std.to_str(added) + " skipped=" + std.to_str(skipped) + " failed=" + std.to_str(missing);
}

fn import_codex_mcp_config(config_path: str) -> str {
    if (!file_io.file_exists(config_path)) {
        return "mcp import failed: config not found: " + config_path;
    }
    let content: str = file_io.read_file(config_path);
    let rest: str = content;
    let current: str = "";
    let in_env: bool = false;
    let command: str = "";
    let args_text: str = "";
    let env_text: str = "";
    let url: str = "";
    let transport: str = "";
    let added: i32 = 0;
    let skipped: i32 = 0;

    while (std.len(rest) > 0) {
        let raw_line: str = std.split_first(rest, "\n");
        rest = std.split_rest(rest, "\n");
        let line: str = std.trim(raw_line);
        if (std.starts_with(line, "[")) {
            let next_current: str = "";
            let next_in_env: bool = false;
            if (std.starts_with(line, "[mcp_servers.")) {
                let section: str = std.substr(line, 13);
                let end_pos: i32 = std.find(section, "]");
                if (end_pos >= 0) { section = std.substr_len(section, 0, end_pos); }
                if (std.ends_with(section, ".env")) {
                    next_current = std.substr_len(section, 0, std.len(section) - 4);
                    next_in_env = true;
                } else {
                    next_current = section;
                }
            }
            if (std.len(current) > 0 && current != next_current) {
                if (std.len(std.trim(command)) > 0 || std.len(std.trim(url)) > 0) {
                    let full: str = "";
                    if (std.len(std.trim(command)) > 0) {
                        full = env_text + shell_quote(command);
                        if (std.len(std.trim(args_text)) > 0) { full = full + " " + args_text; }
                    }
                    let final_transport: str = transport;
                    if (std.len(std.trim(final_transport)) == 0) {
                        final_transport = "stdio";
                        if (std.len(std.trim(url)) > 0) { final_transport = "streamable-http"; }
                    }
                    let rc: i32 = storage_mcp_server_create_transport(current, final_transport, full, url);
                    if (rc == 0) { added = added + 1; }
                    else if (rc == 2) { skipped = skipped + 1; }
                }
            }
            if (current != next_current) {
                command = "";
                args_text = "";
                env_text = "";
                url = "";
                transport = "";
            }
            current = next_current;
            in_env = next_in_env;
        } else if (std.len(current) > 0 && std.contains(line, "=")) {
            let key: str = std.trim(std.split_first(line, "="));
            let value: str = std.trim(std.split_rest(line, "="));
            if (in_env) {
                let env_value: str = toml_unquote(value);
                if (std.len(key) > 0) { env_text = env_text + key + "=" + shell_quote(env_value) + " "; }
            } else if (key == "command") {
                command = toml_unquote(value);
            } else if (key == "args") {
                args_text = toml_array_to_args(value);
            } else if (key == "url") {
                url = toml_unquote(value);
            } else if (key == "transport") {
                transport = toml_unquote(value);
            }
        }
    }
    if (std.len(current) > 0 && (std.len(std.trim(command)) > 0 || std.len(std.trim(url)) > 0)) {
        let full_last: str = "";
        if (std.len(std.trim(command)) > 0) {
            full_last = env_text + shell_quote(command);
            if (std.len(std.trim(args_text)) > 0) { full_last = full_last + " " + args_text; }
        }
        let final_transport_last: str = transport;
        if (std.len(std.trim(final_transport_last)) == 0) {
            final_transport_last = "stdio";
            if (std.len(std.trim(url)) > 0) { final_transport_last = "streamable-http"; }
        }
        let rc_last: i32 = storage_mcp_server_create_transport(current, final_transport_last, full_last, url);
        if (rc_last == 0) { added = added + 1; }
        else if (rc_last == 2) { skipped = skipped + 1; }
    }
    return "mcp imported: added=" + std.to_str(added) + " skipped=" + std.to_str(skipped);
}

fn mcp_json_escape(value: str) -> str {
    let out: str = std.replace(value, "\\", "\\\\");
    out = std.replace(out, "\"", "\\\"");
    out = std.replace(out, "\r", "\\r");
    out = std.replace(out, "\n", "\\n");
    out = std.replace(out, "\t", "\\t");
    return out;
}

fn mcp_json_string_field(content: str, field: str) -> str {
    let marker: str = "\"" + field + "\"";
    let pos: i32 = std.find(content, marker);
    if (pos < 0) { return ""; }
    let after_marker: str = std.substr(content, pos + std.len(marker));
    let after_colon: str = std.trim(std.split_rest(after_marker, ":"));
    if (!std.starts_with(after_colon, "\"")) { return ""; }
    let inner: str = std.substr(after_colon, 1);
    let end_pos: i32 = std.find(inner, "\"");
    if (end_pos < 0) { return ""; }
    let raw: str = std.substr_len(inner, 0, end_pos);
    return std.replace(std.replace(std.replace(std.replace(raw, "\\n", "\n"), "\\r", "\r"), "\\t", "\t"), "\\\"", "\"");
}

fn mcp_json_raw_id(content: str) -> str {
    let marker: str = "\"id\"";
    let pos: i32 = std.find(content, marker);
    if (pos < 0) { return "null"; }
    let after_marker: str = std.substr(content, pos + std.len(marker));
    let after_colon: str = std.trim(std.split_rest(after_marker, ":"));
    if (std.starts_with(after_colon, "\"")) {
        let inner: str = std.substr(after_colon, 1);
        let end_pos: i32 = std.find(inner, "\"");
        if (end_pos < 0) { return "null"; }
        return "\"" + mcp_json_escape(std.substr_len(inner, 0, end_pos)) + "\"";
    }
    let comma_pos: i32 = std.find(after_colon, ",");
    let brace_pos: i32 = std.find(after_colon, "}");
    let end: i32 = comma_pos;
    if (end < 0 || (brace_pos >= 0 && brace_pos < end)) { end = brace_pos; }
    if (end < 0) { return "null"; }
    return std.trim(std.substr_len(after_colon, 0, end));
}

fn mcp_reply_result(id: str, result_json: str) -> void {
    if (id == "null") { return; }
    std.print_raw("{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":" + result_json + "}\n");
}

fn mcp_reply_error(id: str, code: i32, message: str) -> void {
    if (id == "null") { return; }
    std.print_raw("{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"error\":{\"code\":" + std.to_str(code) + ",\"message\":\"" + mcp_json_escape(message) + "\"}}\n");
}

fn mcp_text_result(text: str, is_error: bool) -> str {
    let flag: str = "false";
    if (is_error) { flag = "true"; }
    return "{\"content\":[{\"type\":\"text\",\"text\":\"" + mcp_json_escape(text) + "\"}],\"isError\":" + flag + "}";
}

fn mcp_tool_schema() -> str {
    return "{\"tools\":["
        + "{\"name\":\"conductor.session_state\",\"description\":\"Read Conductor session event ledger and role state.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"session_id\":{\"type\":\"string\"}}}},"
        + "{\"name\":\"conductor.dispatch_role\",\"description\":\"Orchestrator-only: dispatch a task to a specialist role.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"role\":{\"type\":\"string\"},\"session_id\":{\"type\":\"string\"},\"target_role\":{\"type\":\"string\"},\"task\":{\"type\":\"string\"}},\"required\":[\"role\",\"target_role\",\"task\"]}},"
        + "{\"name\":\"conductor.ask_user\",\"description\":\"Orchestrator-only: ask the user a blocking question.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"role\":{\"type\":\"string\"},\"session_id\":{\"type\":\"string\"},\"question\":{\"type\":\"string\"}},\"required\":[\"role\",\"question\"]}},"
        + "{\"name\":\"conductor.end_chat\",\"description\":\"Orchestrator-only: end the chat with a reason.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"role\":{\"type\":\"string\"},\"session_id\":{\"type\":\"string\"},\"reason\":{\"type\":\"string\"}},\"required\":[\"role\"]}},"
        + "{\"name\":\"conductor.compact_context\",\"description\":\"Orchestrator-only: write verified compaction. Summary must include original prompt excerpt and real event id.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"role\":{\"type\":\"string\"},\"session_id\":{\"type\":\"string\"},\"summary\":{\"type\":\"string\"}},\"required\":[\"role\",\"summary\"]}},"
        + "{\"name\":\"conductor.record_decision\",\"description\":\"Record a role decision in the session ledger.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"role\":{\"type\":\"string\"},\"session_id\":{\"type\":\"string\"},\"text\":{\"type\":\"string\"}},\"required\":[\"role\",\"text\"]}},"
        + "{\"name\":\"conductor.activate_skill\",\"description\":\"Enable a registered Conductor skill.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"skill\":{\"type\":\"string\"}},\"required\":[\"skill\"]}}"
        + "]}";
}

fn mcp_effective_session(request: str) -> str {
    let sid: str = mcp_json_string_field(request, "session_id");
    if (std.len(std.trim(sid)) > 0) { return sid; }
    return storage_get_active_session();
}

fn mcp_call_tool(request: str) -> str {
    let tool: str = mcp_json_string_field(request, "name");
    let role: str = mcp_json_string_field(request, "role");
    if (std.len(std.trim(role)) == 0) { role = "orchestrator"; }
    let session_id: str = mcp_effective_session(request);
    if (tool == "conductor.activate_skill") {
        let skill: str = mcp_json_string_field(request, "skill");
        let rc: i32 = storage_skill_set_enabled(skill, true);
        if (rc == 0) { return mcp_text_result("skill enabled: " + skill, false); }
        return mcp_text_result("skill not found: " + skill, true);
    }
    if (std.len(std.trim(session_id)) == 0) {
        return mcp_text_result("no active session", true);
    }
    storage_session_bootstrap(session_id);
    if (tool == "conductor.session_state") {
        return mcp_text_result("session=" + session_id + "\n" + storage_events_get(session_id), false);
    }
    if (tool == "conductor.record_decision") {
        let text: str = mcp_json_string_field(request, "text");
        let id: str = storage_record_event(session_id, "decision", role, text);
        return mcp_text_result("decision recorded: " + id, false);
    }
    if (tool == "conductor.ask_user") {
        if (role != "orchestrator") {
            storage_record_event(session_id, "policy_denied", role, "ask-user");
            return mcp_text_result("orchestrator-only control: ask-user", true);
        }
        let question: str = mcp_json_string_field(request, "question");
        let id: str = storage_record_event(session_id, "ask_user", role, question);
        return mcp_text_result("QUESTION " + id + ": " + question, false);
    }
    if (tool == "conductor.end_chat") {
        if (role != "orchestrator") {
            storage_record_event(session_id, "policy_denied", role, "end-chat");
            return mcp_text_result("orchestrator-only control: end-chat", true);
        }
        let reason: str = mcp_json_string_field(request, "reason");
        let id: str = storage_record_event(session_id, "chat_end", role, reason);
        return mcp_text_result("CHAT_END " + id + ": " + reason, false);
    }
    if (tool == "conductor.dispatch_role") {
        if (role != "orchestrator") {
            storage_record_event(session_id, "policy_denied", role, "dispatch-role");
            return mcp_text_result("orchestrator-only control: dispatch-role", true);
        }
        let target: str = mcp_json_string_field(request, "target_role");
        let task: str = mcp_json_string_field(request, "task");
        storage_record_event(session_id, "dispatch_role", role, target);
        let response: str = run_agent_turn(target, task, storage_get_active_model(), storage_get_active_provider(), session_id);
        return mcp_text_result(response, false);
    }
    if (tool == "conductor.compact_context") {
        if (role != "orchestrator") {
            storage_record_event(session_id, "policy_denied", role, "compact");
            return mcp_text_result("orchestrator-only control: compact", true);
        }
        let summary: str = mcp_json_string_field(request, "summary");
        let rc: i32 = storage_compaction_create(session_id, role, summary);
        if (rc == 0) { return mcp_text_result("compaction saved", false); }
        if (rc == 2) { return mcp_text_result("compaction requires original_prompt event", true); }
        if (rc == 3) { return mcp_text_result("compaction summary must include original prompt excerpt", true); }
        if (rc == 4) { return mcp_text_result("compaction summary must cite at least one real event id", true); }
        return mcp_text_result("orchestrator-only control: compact", true);
    }
    return mcp_text_result("unknown tool: " + tool, true);
}

fn mcp_construct_tool_request(tool: str, args_json: str) -> str {
    let clean: str = std.trim(args_json);
    if (std.starts_with(clean, "{")) {
        let body: str = std.substr(clean, 1);
        if (std.starts_with(std.trim(body), "}")) {
            return "{\"name\":\"" + mcp_json_escape(tool) + "\"}";
        }
        return "{\"name\":\"" + mcp_json_escape(tool) + "\"," + body;
    }
    return "{\"name\":\"" + mcp_json_escape(tool) + "\"}";
}

fn mcp_read_line() -> str {
    let out: str = "";
    let reading: bool = true;
    while (reading) {
        let ch: str = std.input("", 1);
        if (std.len(ch) == 0) {
            return out;
        }
        out = out + ch;
        if (std.len(out) >= 65536) {
            return out;
        }
    }
    return out;
}

fn mcp_serve_conductor_loop() -> i32 {
    storage_init();
    let running: bool = true;
    let empty_reads: i32 = 0;
    while (running) {
        let line: str = std.trim(mcp_read_line());
        if (std.len(line) == 0) {
            empty_reads = empty_reads + 1;
            if (empty_reads >= 3) { running = false; }
        } else {
            empty_reads = 0;
            let id: str = mcp_json_raw_id(line);
            let method: str = mcp_json_string_field(line, "method");
            if (method == "initialize") {
                mcp_reply_result(id, "{\"protocolVersion\":\"2025-06-18\",\"capabilities\":{\"tools\":{},\"resources\":{},\"prompts\":{}},\"serverInfo\":{\"name\":\"conductor-control\",\"version\":\"0.1.0\"}}");
            } else if (method == "shutdown") {
                mcp_reply_result(id, "null");
                running = false;
            } else if (method == "exit") {
                running = false;
            } else if (method == "notifications/initialized") {
                // no response for notification
            } else if (method == "tools/list") {
                mcp_reply_result(id, mcp_tool_schema());
            } else if (method == "resources/list") {
                mcp_reply_result(id, "{\"resources\":[{\"uri\":\"conductor://session/events\",\"name\":\"Session events\",\"mimeType\":\"text/plain\"}]}");
            } else if (method == "resources/read") {
                let sid: str = storage_get_active_session();
                let text: str = "";
                if (std.len(std.trim(sid)) > 0) { text = storage_events_get(sid); }
                mcp_reply_result(id, "{\"contents\":[{\"uri\":\"conductor://session/events\",\"mimeType\":\"text/plain\",\"text\":\"" + mcp_json_escape(text) + "\"}]}");
            } else if (method == "prompts/list") {
                mcp_reply_result(id, "{\"prompts\":[]}");
            } else if (method == "tools/call") {
                mcp_reply_result(id, mcp_call_tool(line));
            } else {
                mcp_reply_error(id, -32601, "method not found: " + method);
            }
        }
    }
    return 0;
}

fn build_agent_prompt(message: str, agent: str) -> str {
    let prompt: str = "";
    let agent_prompt: str = storage_agent_prompt(agent);
    let context: str = storage_context_get();
    let skills: str = storage_enabled_skills_context();
    if (std.len(std.trim(agent_prompt)) > 0) {
        prompt = prompt + "Agent instructions:\n" + agent_prompt + "\n\n";
    }
    if (std.len(std.trim(skills)) > 0) {
        prompt = prompt + "Enabled skills:\n" + skills + "\n";
    }
    if (std.len(std.trim(context)) > 0) {
        prompt = prompt + "Project context:\n" + context + "\n";
    }
    prompt = prompt + "User request:\n" + message;
    return prompt;
}

fn build_agent_prompt_scoped(message: str, agent: str, session_id: str) -> str {
    let prompt: str = build_agent_prompt(message, agent);
    let role_context: str = storage_role_context_get(session_id, agent);
    if (std.len(std.trim(role_context)) > 0) {
        prompt = "Role-local context for " + agent + ":\n" + role_context + "\n\n" + prompt;
    }
    return prompt;
}

fn run_agent_turn(agent: str, task: str, model: str, provider: str, session_id: str) -> str {
    let model_prompt: str = build_agent_prompt_scoped(task, agent, session_id);
    storage_record_event(session_id, "role_input", agent, task);
    if (ai_provider_exists(provider)) {
        let response: str = ai_run(model_prompt, model, provider);
        storage_record_event(session_id, "role_output", agent, response);
        storage_role_append(session_id, agent, "input", task);
        storage_role_append(session_id, agent, "output", response);
        storage_auto_compact_if_needed(session_id);
        return response;
    }
    let fallback: str = ai_placeholder_response(model_prompt, model, agent);
    storage_record_event(session_id, "role_output", agent, fallback);
    storage_role_append(session_id, agent, "input", task);
    storage_role_append(session_id, agent, "output", fallback);
    storage_auto_compact_if_needed(session_id);
    return fallback;
}

fn print_role_section(title: str, content: str) -> void {
    std.print("");
    std.print("## " + title);
    std.print(content);
}

fn command_run(argc: i32, argv: u64) -> i32 {
    storage_init();
    let provider: str = option_value(argc, argv, "--provider", storage_get_active_provider());
    if (std.len(std.trim(provider)) == 0) { provider = "openrouter"; }
    let model: str = option_value(argc, argv, "--model", storage_get_active_model());
    let agent: str = option_value(argc, argv, "--agent", storage_get_active_agent());
    let file_path: str = option_value(argc, argv, "--file", "");
    let message: str = collect_message(argc, argv, 2);
    if (std.len(file_path) > 0) {
        if (!file_io.file_exists(file_path)) {
            ui_error("File not found: " + file_path);
            return 1;
        }
        message = message + "\n\nAttached file " + file_path + ":\n" + file_io.read_file(file_path);
    }
    if (std.len(std.trim(message)) == 0) {
        message = std.input("Message: ", 4096);
    }
    let title: str = message;
    if (std.len(title) > 48) {
        title = std.substr_len(title, 0, 48);
    }
    let id: str = storage_create_session(title);
    storage_record_event(id, "original_prompt", "user", message);
    storage_append_message(id, "user", message);
    let response: str = "";
    let model_prompt: str = build_agent_prompt(message, agent);
    if (ai_provider_exists(provider)) {
        response = ai_run(model_prompt, model, provider);
    } else {
        response = ai_placeholder_response(model_prompt, model, agent);
    }
    ui_logo();
    std.print("");
    std.print(response);
    // execute any TOOL: directives in the assistant response (auto-run allowed tools)
    process_tool_commands_from_response(response);
    storage_append_message(id, "assistant", response);
    storage_record_event(id, "role_output", agent, response);
    storage_auto_compact_if_needed(id);
    storage_increment_runs();
    std.print("");
    ui_kv("session", id);
    return 0;
}

fn first_word(line: str) -> str {
    return std.split_first(std.trim(line), " ");
}

fn rest_words(line: str) -> str {
    return std.trim(std.split_rest(std.trim(line), " "));
}

fn command_models(argc: i32, argv: u64) -> i32 {
    let verbose: bool = has_arg(argc, argv, "--verbose");
    let provider: str = "";
    if (argc >= 3) {
        if (!std.starts_with(arg_at(argv, 2), "--")) {
            provider = arg_at(argv, 2);
        }
    }
    let rc: i32 = ai_print_models(provider, verbose);
    if (rc != 0) {
        ui_error("Provider not found: " + provider);
    }
    return rc;
}

fn command_providers(argc: i32, argv: u64) -> i32 {
    storage_init();
    storage_providers_init();
    if (argc >= 3) {
        if (arg_at(argv, 2) == "list") {
            std.print(storage_provider_list());
            return 0;
        }
    }
    if (argc >= 3) {
        if (arg_at(argv, 2) == "add") {
            let name: str = option_value(argc, argv, "--name", "");
            let kind: str = option_value(argc, argv, "--kind", "openrouter");
            let conn: str = option_value(argc, argv, "--conn", "env:OPENROUTER_API_KEY");
            if (std.len(std.trim(name)) == 0) { ui_error("Usage: conductor providers add --name NAME --kind KIND --conn CONNECTION"); return 1; }
            let rc: i32 = storage_provider_create(name, kind, conn);
            if (rc == 0) { ui_ok("Provider added: " + name); return 0; }
            if (rc == 2) { ui_error("Provider already exists: " + name); return 1; }
            ui_error("Failed to add provider.");
            return 1;
        }
    }
    if (argc >= 3) {
        if (arg_at(argv, 2) == "show") {
            if (argc < 4) { ui_error("Usage: conductor providers show <name>"); return 1; }
            let cfg: str = storage_provider_get(arg_at(argv, 3));
            if (std.len(std.trim(cfg)) == 0) { ui_error("Provider not found: " + arg_at(argv, 3)); return 1; }
            std.print(cfg);
            return 0;
        }
    }
    if (argc >= 3) {
        if (arg_at(argv, 2) == "use") {
            if (argc < 4) { ui_error("Usage: conductor providers use <name>"); return 1; }
            let rc: i32 = storage_set_active_provider(arg_at(argv, 3));
            if (rc == 0) { ui_ok("Active provider: " + arg_at(argv, 3)); return 0; }
            ui_error("Provider not found: " + arg_at(argv, 3));
            return 1;
        }
    }
    if (argc >= 3) {
        if (arg_at(argv, 2) == "delete") {
            if (argc < 4) { ui_error("Usage: conductor providers delete <name>"); return 1; }
            let rc: i32 = storage_provider_delete(arg_at(argv, 3));
            if (rc == 0) { ui_ok("Provider deleted: " + arg_at(argv, 3)); return 0; }
            ui_error("Provider not found: " + arg_at(argv, 3));
            return 1;
        }
    }
    // default: list
    std.print(storage_provider_list());
    return 0;
}

fn command_agent(argc: i32, argv: u64) -> i32 {
    storage_init();
    if (argc >= 3) {
        if (arg_at(argv, 2) == "create") {
            let name: str = option_value(argc, argv, "--name", "conductor-agent");
            let desc: str = option_value(argc, argv, "--description", "Conductor agent");
            let rc: i32 = storage_create_agent(name, desc, "all", "read,edit,glob,grep,bash,webfetch,task,mcp");
            if (rc == 0) { ui_ok("Agent created: " + name); return 0; }
            if (rc == 2) { ui_error("Agent already exists: " + name); return 1; }
            ui_error("Agent name is required.");
            return 1;
        }
    }
    if (argc >= 3) {
        if (arg_at(argv, 2) == "use") {
            if (argc < 4) { ui_error("Usage: conductor agent use <name>"); return 1; }
            let rc: i32 = storage_set_active_agent(arg_at(argv, 3));
            if (rc == 0) { ui_ok("Active agent: " + arg_at(argv, 3)); return 0; }
            ui_error("Agent not found: " + arg_at(argv, 3));
            return 1;
        }
    }
    if (argc >= 3) {
        if (arg_at(argv, 2) == "show") {
            let name: str = storage_get_active_agent();
            if (argc >= 4) { name = arg_at(argv, 3); }
            let rc: i32 = storage_print_agent(name);
            if (rc != 0) { ui_error("Agent not found: " + name); }
            return rc;
        }
    }
    if (argc >= 3) {
        if (arg_at(argv, 2) == "current") {
            std.print(storage_get_active_agent());
            return 0;
        }
    }
    if (argc >= 3) {
        if (arg_at(argv, 2) == "list") {
            storage_print_agents();
            return 0;
        }
    }
    if (argc >= 3) {
        if (arg_at(argv, 2) == "delete") {
            if (argc < 4) { ui_error("Usage: conductor agent delete <name>"); return 1; }
            let rc: i32 = storage_delete_agent(arg_at(argv, 3));
            if (rc == 0) { ui_ok("Agent deleted: " + arg_at(argv, 3)); return 0; }
            if (rc == 2) { ui_error("The default agent cannot be deleted."); return 1; }
            ui_error("Agent not found: " + arg_at(argv, 3));
            return 1;
        }
    }
    ui_error("Usage: conductor agent create|list|use|show|current|delete");
    return 1;
}

fn command_context(argc: i32, argv: u64) -> i32 {
    storage_init();
    if (argc < 3) {
        let content: str = storage_context_get();
        if (std.len(std.trim(content)) == 0) { std.print("No context saved."); return 0; }
        std.print(content);
        return 0;
    }
    let sub: str = arg_at(argv, 2);
    if (sub == "show" || sub == "list") {
        let content: str = storage_context_get();
        if (std.len(std.trim(content)) == 0) { std.print("No context saved."); return 0; }
        std.print(content);
        return 0;
    }
    if (sub == "clear") {
        storage_context_clear();
        ui_ok("Context cleared.");
        return 0;
    }
    if (sub == "add") {
        let label: str = "note";
        let start: i32 = 3;
        if (argc >= 5) {
            label = arg_at(argv, 3);
            start = 4;
        }
        let text: str = collect_message(argc, argv, start);
        if (std.len(std.trim(text)) == 0) { ui_error("Usage: conductor context add [label] <text>"); return 1; }
        storage_context_append(label, text);
        ui_ok("Context added: " + label);
        return 0;
    }
    if (sub == "file") {
        if (argc < 4) { ui_error("Usage: conductor context file <path>"); return 1; }
        let path: str = arg_at(argv, 3);
        if (!file_io.file_exists(path)) { ui_error("File not found: " + path); return 1; }
        storage_context_append(path, file_io.read_file(path));
        ui_ok("Context file added: " + path);
        return 0;
    }
    ui_error("Usage: conductor context show|add|file|clear");
    return 1;
}

fn command_orchestrate(argc: i32, argv: u64) -> i32 {
    storage_init();
    let provider: str = option_value(argc, argv, "--provider", storage_get_active_provider());
    if (std.len(std.trim(provider)) == 0) { provider = "openrouter"; }
    let model: str = option_value(argc, argv, "--model", storage_get_active_model());
    let message: str = collect_message(argc, argv, 2);
    if (std.len(std.trim(message)) == 0) {
        ui_error("Usage: conductor orchestrate <task>");
        return 1;
    }

    ui_logo();
    std.print("");
    ui_kv("provider", provider);
    ui_kv("model", model);
    ui_kv("mode", ai_openrouter_mode());

    let session_title: str = "orchestrate: " + message;
    let final_title: str = session_title;
    if (std.len(final_title) > 48) { final_title = std.substr_len(final_title, 0, 48); }
    let id: str = storage_create_session(final_title);
    storage_record_event(id, "original_prompt", "user", message);

    let plan_task: str = "Create a short execution plan for this task. Return ordered steps and success checks.\n\nTask:\n" + message;
    storage_record_event(id, "dispatch_role", "orchestrator", "orchestrator");
    let plan: str = run_agent_turn("orchestrator", plan_task, model, provider, id);
    print_role_section("orchestrator", plan);

    let design_task: str = "Turn this plan into concrete implementation notes. Name files, functions, data flow, and tests.\n\nTask:\n" + message + "\n\nPlan:\n" + plan;
    storage_record_event(id, "dispatch_role", "orchestrator", "designer");
    let design: str = run_agent_turn("designer", design_task, model, provider, id);
    print_role_section("designer", design);

    let code_task: str = "Produce the focused code-change approach for this task. Keep it scoped and implementation-ready.\n\nTask:\n" + message + "\n\nPlan:\n" + plan + "\n\nDesign:\n" + design;
    storage_record_event(id, "dispatch_role", "orchestrator", "coder");
    let code_notes: str = run_agent_turn("coder", code_task, model, provider, id);
    print_role_section("coder", code_notes);

    let review_task: str = "Review the proposed implementation. List checks to run, likely risks, and pass/fail criteria.\n\nTask:\n" + message + "\n\nPlan:\n" + plan + "\n\nDesign:\n" + design + "\n\nCoder notes:\n" + code_notes;
    storage_record_event(id, "dispatch_role", "orchestrator", "reviewer");
    let review: str = run_agent_turn("reviewer", review_task, model, provider, id);
    print_role_section("reviewer", review);

    let transcript: str = "orchestrator:\n" + plan + "\n\ndesigner:\n" + design + "\n\ncoder:\n" + code_notes + "\n\nreviewer:\n" + review;
    storage_append_message(id, "user", message);
    storage_append_message(id, "assistant", transcript);
    storage_increment_runs();
    std.print("");
    ui_kv("session", id);
    return 0;
}

fn command_env(argc: i32, argv: u64) -> i32 {
    storage_init();
    if (argc < 3) {
        let content: str = storage_env_list();
        if (std.len(std.trim(content)) == 0) { std.print("No stored environment values."); return 0; }
        std.print(content);
        return 0;
    }
    let name: str = arg_at(argv, 2);
    if (argc < 4) {
        let cur: str = storage_env_get(name);
        std.print(cur);
        return 0;
    }
    let value: str = collect_message(argc, argv, 3);
    storage_env_set(name, value);
    ui_ok("Stored env: " + name);
    return 0;
}

fn command_permission(argc: i32, argv: u64) -> i32 {
    storage_init();
    if (argc < 3) {
        storage_print_permissions();
        return 0;
    }
    if (arg_at(argv, 2) == "list") {
        storage_print_permissions();
        return 0;
    }
    if (argc >= 3) {
        if (arg_at(argv, 2) == "reset") {
            storage_permissions_reset();
            ui_ok("Permissions reset.");
            return 0;
        }
    }
    if (argc < 4) {
        ui_error("Usage: conductor permission allow|deny|ask <tool>");
        return 1;
    }
    let action: str = arg_at(argv, 2);
    let tool: str = arg_at(argv, 3);
    if (!(action == "allow" || action == "deny" || action == "ask")) {
        ui_error("Permission action must be allow, deny, ask, list, or reset.");
        return 1;
    }
    let rc: i32 = storage_permission_set(tool, action);
    if (rc == 0) {
        ui_ok(tool + " = " + action);
        return 0;
    }
    if (rc == 1) {
        ui_error("Unknown tool: " + tool);
        return 1;
    }
    ui_error("Unknown permission value: " + action);
    return 1;
}

fn command_skill(argc: i32, argv: u64) -> i32 {
    storage_init();
    if (argc < 3) {
        let list: str = storage_skill_list();
        if (std.len(std.trim(list)) == 0) { std.print("No skills configured."); return 0; }
        std.print(list);
        return 0;
    }
    let sub: str = arg_at(argv, 2);
    if (sub == "list" || sub == "ls") {
        let list: str = storage_skill_list();
        if (std.len(std.trim(list)) == 0) { std.print("No skills configured."); return 0; }
        std.print(list);
        return 0;
    }
    if (sub == "import-codex") {
        let codex_home: str = option_value(argc, argv, "--codex-home", codex_home_default());
        let skills_dir: str = option_value(argc, argv, "--skills-dir", file_io.path_join(codex_home, "skills"));
        std.print(import_codex_skills(skills_dir));
        return 0;
    }
    if (sub == "add") {
        if (argc < 4) { ui_error("Usage: conductor skill add <SKILL.md> [--name NAME]"); return 1; }
        let path: str = arg_at(argv, 3);
        if (!file_io.file_exists(path)) { ui_error("Skill file not found: " + path); return 1; }
        let content: str = file_io.read_file(path);
        let name: str = option_value(argc, argv, "--name", "");
        if (std.len(std.trim(name)) == 0) {
            name = parse_field(content, "name");
        }
        if (std.len(std.trim(name)) == 0) {
            name = skill_name_from_path(path);
        }
        let desc: str = parse_field(content, "description");
        let rc: i32 = storage_skill_register(name, desc, path, content);
        if (rc == 0) { ui_ok("Skill added: " + name); return 0; }
        if (rc == 2) { ui_error("Skill already exists: " + name); return 1; }
        ui_error("Skill name is required.");
        return 1;
    }
    if (sub == "show") {
        if (argc < 4) { ui_error("Usage: conductor skill show <name>"); return 1; }
        let cfg: str = storage_skill_get(arg_at(argv, 3));
        if (std.len(std.trim(cfg)) == 0) { ui_error("Skill not found: " + arg_at(argv, 3)); return 1; }
        std.print(cfg);
        return 0;
    }
    if (sub == "enable") {
        if (argc < 4) { ui_error("Usage: conductor skill enable <name>"); return 1; }
        let rc: i32 = storage_skill_set_enabled(arg_at(argv, 3), true);
        if (rc == 0) { ui_ok("Skill enabled: " + arg_at(argv, 3)); return 0; }
        ui_error("Skill not found: " + arg_at(argv, 3));
        return 1;
    }
    if (sub == "disable") {
        if (argc < 4) { ui_error("Usage: conductor skill disable <name>"); return 1; }
        let rc: i32 = storage_skill_set_enabled(arg_at(argv, 3), false);
        if (rc == 0) { ui_ok("Skill disabled: " + arg_at(argv, 3)); return 0; }
        ui_error("Skill not found: " + arg_at(argv, 3));
        return 1;
    }
    if (sub == "context") {
        let ctx: str = storage_enabled_skills_context();
        if (std.len(std.trim(ctx)) == 0) { std.print("No enabled skill context."); return 0; }
        std.print(ctx);
        return 0;
    }
    ui_error("Usage: conductor skill add|import-codex|list|show|enable|disable|context");
    return 1;
}

fn command_mcp(argc: i32, argv: u64) -> i32 {
    storage_init();
    if (argc < 3) {
        let list: str = storage_mcp_server_list();
        if (std.len(std.trim(list)) == 0) { std.print("No MCP servers configured."); return 0; }
        std.print(list);
        return 0;
    }
    let sub: str = arg_at(argv, 2);
    if (sub == "list" || sub == "ls") {
        let list: str = storage_mcp_server_list();
        if (std.len(std.trim(list)) == 0) { std.print("No MCP servers configured."); return 0; }
        std.print(list);
        return 0;
    }
    if (sub == "import-codex") {
        let codex_home: str = option_value(argc, argv, "--codex-home", codex_home_default());
        let config_path: str = option_value(argc, argv, "--config", file_io.path_join(codex_home, "config.toml"));
        std.print(import_codex_mcp_config(config_path));
        return 0;
    }
    if (sub == "add") {
        let name: str = option_value(argc, argv, "--name", "");
        let command: str = option_value(argc, argv, "--command", "");
        let url: str = option_value(argc, argv, "--url", "");
        let transport: str = option_value(argc, argv, "--transport", "stdio");
        if (std.len(std.trim(url)) > 0 && transport == "stdio") { transport = "streamable-http"; }
        if (std.len(std.trim(name)) == 0 || (std.len(std.trim(command)) == 0 && std.len(std.trim(url)) == 0)) {
            ui_error("Usage: conductor mcp add --name NAME --command COMMAND OR --url URL [--transport streamable-http|sse]");
            return 1;
        }
        let rc: i32 = storage_mcp_server_create_transport(name, transport, command, url);
        if (rc == 0) { ui_ok("MCP server added: " + name); return 0; }
        if (rc == 2) { ui_error("MCP server already exists: " + name); return 1; }
        ui_error("MCP server command or URL is required.");
        return 1;
    }
    if (sub == "show") {
        if (argc < 4) { ui_error("Usage: conductor mcp show <name>"); return 1; }
        let cfg: str = storage_mcp_server_get(arg_at(argv, 3));
        if (std.len(std.trim(cfg)) == 0) { ui_error("MCP server not found: " + arg_at(argv, 3)); return 1; }
        std.print(cfg);
        return 0;
    }
    if (sub == "remove" || sub == "delete") {
        if (argc < 4) { ui_error("Usage: conductor mcp remove <name>"); return 1; }
        let rc: i32 = storage_mcp_server_delete(arg_at(argv, 3));
        if (rc == 0) { ui_ok("MCP server removed: " + arg_at(argv, 3)); return 0; }
        ui_error("MCP server not found: " + arg_at(argv, 3));
        return 1;
    }
    if (sub == "conductor-tools-json") {
        std.print(mcp_tool_schema());
        return 0;
    }
    if (sub == "conductor-resources-json") {
        std.print("{\"resources\":[{\"uri\":\"conductor://session/events\",\"name\":\"Session events\",\"mimeType\":\"text/plain\"}]}");
        return 0;
    }
    if (sub == "conductor-prompts-json") {
        std.print("{\"prompts\":[]}");
        return 0;
    }
    if (sub == "conductor-call-json") {
        if (argc < 5) { std.print(mcp_text_result("missing tool or args", true)); return 1; }
        let tool: str = arg_at(argv, 3);
        let args_json: str = collect_message(argc, argv, 4);
        std.print(mcp_call_tool(mcp_construct_tool_request(tool, args_json)));
        return 0;
    }
    if (sub == "serve-conductor") {
        return mcp_serve_conductor_loop();
    }
    if (sub == "tools" || sub == "resources" || sub == "prompts") {
        if (argc < 4) { ui_error("Usage: conductor mcp " + sub + " <name>"); return 1; }
        let name: str = arg_at(argv, 3);
        if (!storage_mcp_server_exists(name)) { ui_error("MCP server not found: " + name); return 1; }
        let bridge: str = "python3 " + shell_quote(script_path("mcp_stdio_bridge.py")) + " --home " + shell_quote(storage_root()) + " --server " + shell_quote(name) + " --action " + shell_quote(sub);
        std.print(process.shell_output(bridge, 65536));
        return 0;
    }
    if (sub == "call") {
        if (argc < 5) { ui_error("Usage: conductor mcp call <server> <tool> [json_args]"); return 1; }
        let server: str = arg_at(argv, 3);
        let tool: str = arg_at(argv, 4);
        let args: str = "{}";
        if (argc >= 6) { args = collect_message(argc, argv, 5); }
        if (!storage_mcp_server_exists(server)) { ui_error("MCP server not found: " + server); return 1; }
        let bridge: str = "python3 " + shell_quote(script_path("mcp_stdio_bridge.py")) + " --home " + shell_quote(storage_root()) + " --server " + shell_quote(server) + " --action call --tool " + shell_quote(tool) + " --args " + shell_quote(args);
        std.print(process.shell_output(bridge, 65536));
        return 0;
    }
    ui_error("Usage: conductor mcp add|import-codex|list|show|remove|tools|resources|prompts|call|serve-conductor");
    return 1;
}

fn command_control(argc: i32, argv: u64) -> i32 {
    storage_init();
    let session_id: str = option_value(argc, argv, "--session", storage_get_active_session());
    let actor: str = option_value(argc, argv, "--role", "orchestrator");
    if (argc < 3) { ui_error("Usage: conductor control state|record-decision|ask-user|end-chat|dispatch-role|compact|compact-auto"); return 1; }
    if (std.len(std.trim(session_id)) == 0) { ui_error("No active session."); return 1; }
    storage_session_bootstrap(session_id);
    let sub: str = arg_at(argv, 2);
    if (sub == "state") {
        ui_kv("session", session_id);
        std.print(storage_events_get(session_id));
        return 0;
    }
    if (sub == "record-decision") {
        let text: str = collect_message(argc, argv, 3);
        if (std.len(std.trim(text)) == 0) { ui_error("Usage: conductor control record-decision <text>"); return 1; }
        let id: str = storage_record_event(session_id, "decision", actor, text);
        ui_ok("Decision recorded: " + id);
        return 0;
    }
    if (sub == "ask-user") {
        if (actor != "orchestrator") {
            storage_record_event(session_id, "policy_denied", actor, "ask-user");
            ui_error("orchestrator-only control: ask-user");
            return 1;
        }
        let question: str = collect_message(argc, argv, 3);
        if (std.len(std.trim(question)) == 0) { ui_error("Usage: conductor control ask-user <question> --role orchestrator"); return 1; }
        let id: str = storage_record_event(session_id, "ask_user", actor, question);
        std.print("QUESTION " + id + ": " + question);
        return 0;
    }
    if (sub == "end-chat") {
        if (actor != "orchestrator") {
            storage_record_event(session_id, "policy_denied", actor, "end-chat");
            ui_error("orchestrator-only control: end-chat");
            return 1;
        }
        let reason: str = collect_message(argc, argv, 3);
        let id: str = storage_record_event(session_id, "chat_end", actor, reason);
        std.print("CHAT_END " + id + ": " + reason);
        return 0;
    }
    if (sub == "dispatch-role") {
        if (actor != "orchestrator") {
            storage_record_event(session_id, "policy_denied", actor, "dispatch-role");
            ui_error("orchestrator-only control: dispatch-role");
            return 1;
        }
        if (argc < 5) { ui_error("Usage: conductor control dispatch-role <role> <task> --role orchestrator"); return 1; }
        let target: str = arg_at(argv, 3);
        let task: str = collect_message(argc, argv, 4);
        storage_record_event(session_id, "dispatch_role", actor, target);
        let provider: str = option_value(argc, argv, "--provider", storage_get_active_provider());
        let model: str = option_value(argc, argv, "--model", storage_get_active_model());
        let response: str = run_agent_turn(target, task, model, provider, session_id);
        std.print(response);
        return 0;
    }
    if (sub == "compact") {
        if (actor != "orchestrator") {
            storage_record_event(session_id, "policy_denied", actor, "compact");
            ui_error("orchestrator-only control: compact");
            return 1;
        }
        let summary: str = collect_message(argc, argv, 3);
        if (std.len(std.trim(summary)) == 0) { ui_error("Usage: conductor control compact <summary with original prompt excerpt and event id> --role orchestrator"); return 1; }
        let rc: i32 = storage_compaction_create(session_id, actor, summary);
        if (rc == 0) { ui_ok("Compaction saved."); return 0; }
        if (rc == 2) { ui_error("Compaction requires original_prompt event."); return 1; }
        if (rc == 3) { ui_error("Compaction summary must include original prompt excerpt."); return 1; }
        if (rc == 4) { ui_error("Compaction summary must cite at least one real event id."); return 1; }
        ui_error("orchestrator-only control: compact");
        return 1;
    }
    if (sub == "compact-auto") {
        if (actor != "orchestrator") {
            storage_record_event(session_id, "policy_denied", actor, "compact-auto");
            ui_error("orchestrator-only control: compact-auto");
            return 1;
        }
        let rc_auto: i32 = storage_auto_compact_if_needed(session_id);
        if (rc_auto == 0) { ui_ok("Auto compaction saved."); return 0; }
        if (rc_auto == 5) { ui_warn("Compaction threshold not reached."); return 0; }
        if (rc_auto == 2) { ui_error("Compaction requires original_prompt event."); return 1; }
        if (rc_auto == 4) { ui_error("Compaction requires a real event id."); return 1; }
        ui_error("Auto compaction failed.");
        return 1;
    }
    ui_error("Usage: conductor control state|record-decision|ask-user|end-chat|dispatch-role|compact|compact-auto");
    return 1;
}

fn command_session(argc: i32, argv: u64) -> i32 {
    if (argc >= 3) {
        if (arg_at(argv, 2) == "list") {
            storage_print_sessions();
            return 0;
        }
    }
    if (argc >= 4) {
        if (arg_at(argv, 2) == "delete") {
            let rc: i32 = storage_delete_session(arg_at(argv, 3));
            if (rc == 0) {
                ui_ok("Session deleted: " + arg_at(argv, 3));
            } else {
                ui_error("Session not found: " + arg_at(argv, 3));
            }
            return rc;
        }
    }
    if (argc >= 3) {
        if (arg_at(argv, 2) == "resume") {
            let id: str = "";
            if (argc >= 4) { id = arg_at(argv, 3); }
            if (std.len(std.trim(id)) == 0) { ui_error("Usage: conductor session resume <sessionID>"); return 1; }
            let rc: i32 = storage_set_active_session(id);
            if (rc == 0) { ui_ok("Active session: " + id); return 0; }
            ui_error("Session not found: " + id);
            return 1;
        }
    }
    if (argc >= 3) {
        if (arg_at(argv, 2) == "cleanup") {
            storage_cleanup_sessions();
            ui_ok("Sessions cleanup complete.");
            return 0;
        }
    }
    ui_error("Usage: conductor session list|delete|resume|cleanup <sessionID>");
    return 1;
}

fn command_config(argc: i32, argv: u64) -> i32 {
    if (argc >= 3) {
        if (arg_at(argv, 2) == "path") {
            storage_init();
            std.print(storage_config_path());
            return 0;
        }
    }
    if (argc >= 3) {
        if (arg_at(argv, 2) == "check") {
            let rc: i32 = storage_config_check();
            if (rc == 0) {
                ui_ok("No config warnings.");
            } else {
                ui_error("Config must contain provider= and model= entries.");
            }
            return rc;
        }
    }
    storage_print_config();
    return 0;
}

fn command_stats() -> i32 {
    storage_print_stats();
    return 0;
}

fn command_status() -> i32 {
    std.print(storage_status_text());
    return 0;
}

fn command_tools() -> i32 {
    storage_init();
    std.print("Tool surfaces");
    std.print("-------------");
    let i: i32 = 0;
    while (i < storage_permission_tool_count()) {
        let tool: str = storage_permission_tool_at(i);
        std.print(tool + " | permission=" + storage_permission_get(tool));
        i = i + 1;
    }
    return 0;
}

fn command_doctor() -> i32 {
    storage_init();
    ui_header("Conductor doctor");
    ui_kv("version", conductor_version());
    ui_kv("home", storage_root());
    ui_kv("active agent", storage_get_active_agent());
    ui_kv("active model", storage_get_active_model());
    ui_kv("active provider", storage_get_active_provider());
    ui_kv("openrouter mode", ai_openrouter_mode());
    std.print("novus: installed");
    std.print("nox: installed");
    std.print("ai api: openrouter chat completions");
    return 0;
}

fn command_init_project() -> i32 {
    storage_init();
    if (!file_io.file_exists("AGENTS.md")) {
        file_io.write_file("AGENTS.md", "# Conductor project instructions\n\nDescribe project conventions, commands, permissions, and agent guidance here.\n");
        ui_ok("Created AGENTS.md");
    } else {
        ui_warn("AGENTS.md already exists.");
    }
    ui_ok("Conductor state ready at " + storage_root());
    return 0;
}

fn command_export(argc: i32, argv: u64) -> i32 {
    let path: str = "conductor-sessions.txt";
    if (argc >= 3) {
        path = arg_at(argv, 2);
    }
    let rc: i32 = storage_export(path);
    if (rc == 0) {
        ui_ok("Exported sessions to " + path);
    } else {
        ui_error("Failed to export sessions to " + path);
    }
    return rc;
}

fn command_import(argc: i32, argv: u64) -> i32 {
    if (argc < 3) {
        ui_error("Usage: conductor import <file>");
        return 1;
    }
    let rc: i32 = storage_import(arg_at(argv, 2));
    if (rc == 0) {
        ui_ok("Imported sessions from " + arg_at(argv, 2));
    } else {
        ui_error("File not found: " + arg_at(argv, 2));
    }
    return rc;
}

fn command_serve(argc: i32, argv: u64) -> i32 {
    let port: str = option_value(argc, argv, "--port", "4096");
    ui_warn("Headless server waits for expanded Novus HTTP/runtime support.");
    std.print("conductor server configured for http://127.0.0.1:" + port);
    return 0;
}

fn command_generate() -> i32 {
    std.print(ai_openapi_placeholder());
    return 0;
}

fn command_remote() -> i32 {
    ui_warn("Remote/cloud session support is deferred behind the provider controller.");
    return 0;
}

fn command_tool(argc: i32, argv: u64) -> i32 {
    if (argc < 3) { ui_error("Usage: conductor tool run <tool> <args>"); return 1; }
    if (arg_at(argv, 2) == "run") {
        if (argc < 4) { ui_error("Usage: conductor tool run <tool> <args>"); return 1; }
        let tool: str = arg_at(argv, 3);
        let args: str = collect_message(argc, argv, 4);
        let out: str = ai_execute_tool(tool, args);
        std.print(out);
        return 0;
    }
    ui_error("Usage: conductor tool run <tool> <args>");
    return 1;
}

fn shell_run_message(message: str) -> void {
    let model: str = storage_get_active_model();
    let agent: str = storage_get_active_agent();
    std.print("You: " + message);
    // Use the active provider (openrouter) when available so persisted keys are used
    let provider: str = storage_get_active_provider();
    let response: str = "";
    let model_prompt: str = build_agent_prompt(message, agent);
    if (ai_provider_exists(provider)) {
        response = ai_run(model_prompt, model, provider);
    } else {
        response = ai_placeholder_response(model_prompt, model, agent);
    }
    std.print("Conductor: " + response);
    // Auto-execute any TOOL directives in response
    process_tool_commands_from_response(response);
    let title: str = message;
    if (std.len(title) > 48) { title = std.substr_len(title, 0, 48); }
    let id: str = storage_record_session(title, message, response);
    std.print("session " + id);
}

fn process_tool_commands_from_response(response: str) -> void {
    let rest: str = response;
    while (std.len(std.trim(rest)) > 0) {
        let line: str = std.split_first(rest, "\n");
        rest = std.split_rest(rest, "\n");
        let tline: str = std.trim(line);
        if (std.starts_with(tline, "TOOL:") || std.starts_with(tline, "tool:")) {
            let after: str = std.trim(std.substr(tline, 5));
            let toolName: str = std.split_first(after, " ");
            let targs: str = std.split_rest(after, " ");
            if (std.len(toolName) > 0) {
                std.print("Executing tool: " + toolName + " " + targs);
                let out: str = ai_execute_tool(toolName, targs);
                std.print("Tool output: " + out);
                let sid: str = storage_get_active_session();
                if (std.len(std.trim(sid)) > 0) { storage_append_message(sid, "tool", out); }
            }
        }
    }
}

fn shell_agent_command(rest: str) -> void {
    let sub: str = first_word(rest);
    let args: str = rest_words(rest);
    if (std.len(sub) == 0 || sub == "list") {
        storage_print_agents();
        return;
    }
    if (sub == "use") {
        if (std.len(args) == 0) { ui_error("Usage: /agent use NAME"); return; }
        let rc: i32 = storage_set_active_agent(first_word(args));
        if (rc == 0) { ui_ok("Active agent: " + first_word(args)); return; }
        ui_error("Agent not found: " + first_word(args));
        return;
    }
    if (sub == "show") {
        let name: str = args;
        if (std.len(name) == 0) { name = storage_get_active_agent(); }
        let rc: i32 = storage_print_agent(first_word(name));
        if (rc != 0) { ui_error("Agent not found: " + first_word(name)); }
        return;
    }
    if (sub == "create") {
        let name: str = first_word(args);
        let desc: str = rest_words(args);
        if (std.len(name) == 0) { ui_error("Usage: /agent create NAME DESCRIPTION"); return; }
        let final_desc: str = desc;
        if (std.len(final_desc) == 0) { final_desc = "Interactive Conductor agent"; }
        let rc: i32 = storage_create_agent(name, final_desc, "all", "read,edit,glob,grep,bash,webfetch,task,mcp");
        if (rc == 0) { ui_ok("Agent created: " + name); return; }
        if (rc == 2) { ui_error("Agent already exists: " + name); return; }
        ui_error("Could not create agent.");
        return;
    }
    ui_error("Usage: /agent list|create|use|show");
}

fn shell_permission_command(rest: str) -> void {
    let sub: str = first_word(rest);
    let tool: str = first_word(rest_words(rest));
    if (std.len(sub) == 0 || sub == "list") {
        storage_print_permissions();
        return;
    }
    if (sub == "reset") {
        storage_permissions_reset();
        ui_ok("Permissions reset.");
        return;
    }
    if (!(sub == "allow" || sub == "deny" || sub == "ask")) {
        ui_error("Usage: /permission allow|deny|ask TOOL");
        return;
    }
    let rc: i32 = storage_permission_set(tool, sub);
    if (rc == 0) { ui_ok(tool + " = " + sub); return; }
    ui_error("Unknown tool: " + tool);
}

fn shell_handle_command(line: str) -> bool {
    let body: str = std.trim(std.substr(line, 1));
    let cmd: str = first_word(body);
    let rest: str = rest_words(body);
    if (cmd == "exit" || cmd == "quit" || cmd == "q") {
        std.print("Goodbye.");
        return false;
    }
    if (cmd == "help" || cmd == "?") { ui_shell_help(); return true; }
    if (cmd == "clear") { std.print("\n\n\n\n\n"); return true; }
    if (cmd == "status") { command_status(); return true; }
    if (cmd == "tools") { command_tools(); return true; }
    if (cmd == "sessions" || cmd == "session") {
        if (std.len(rest) == 0) { storage_print_sessions(); return true; }
        let sub: str = first_word(rest);
        let arg: str = rest_words(rest);
        if (sub == "cleanup") { storage_cleanup_sessions(); ui_ok("Sessions cleanup complete."); return true; }
        if (sub == "resume") {
            let id: str = first_word(arg);
            if (std.len(id) == 0) { ui_error("Usage: /sessions resume <sessionID>"); return true; }
            let rc: i32 = storage_set_active_session(id);
            if (rc == 0) { ui_ok("Active session: " + id); } else { ui_error("Session not found: " + id); }
            return true;
        }
        storage_print_sessions();
        return true;
    }
    if (cmd == "providers") {
        if (std.len(rest) == 0) { std.print(storage_provider_list()); return true; }
        let sub: str = first_word(rest);
        let arg: str = rest_words(rest);
        if (sub == "list") { std.print(storage_provider_list()); return true; }
        if (sub == "use") {
            let name: str = first_word(arg);
            if (std.len(name) == 0) { ui_error("Usage: /providers use NAME"); return true; }
            let rc: i32 = storage_set_active_provider(name);
            if (rc == 0) { ui_ok("Active provider: " + name); } else { ui_error("Provider not found: " + name); }
            return true;
        }
        if (sub == "show") {
            let name: str = first_word(arg);
            if (std.len(name) == 0) { ui_error("Usage: /providers show NAME"); return true; }
            let cfg: str = storage_provider_get(name);
            if (std.len(std.trim(cfg)) == 0) { ui_error("Provider not found: " + name); return true; }
            std.print(cfg);
            return true;
        }
        if (sub == "add") {
            // simple form: /providers add NAME KIND CONN
            let name: str = first_word(arg);
            let rest2: str = rest_words(arg);
            let kind: str = first_word(rest2);
            let conn: str = rest_words(rest2);
            if (std.len(name) == 0) { ui_error("Usage: /providers add NAME [KIND] [CONN]"); return true; }
            if (std.len(kind) == 0) { kind = "openrouter"; }
            if (std.len(conn) == 0) { conn = "env:OPENROUTER_API_KEY"; }
            let rc: i32 = storage_provider_create(name, kind, conn);
            if (rc == 0) { ui_ok("Provider added: " + name); } else { ui_error("Could not add provider: " + name); }
            return true;
        }
        if (sub == "delete") {
            let name: str = first_word(arg);
            if (std.len(name) == 0) { ui_error("Usage: /providers delete NAME"); return true; }
            let rc: i32 = storage_provider_delete(name);
            if (rc == 0) { ui_ok("Provider deleted: " + name); } else { ui_error("Provider not found: " + name); }
            return true;
        }
        std.print(storage_provider_list());
        return true;
    }
    if (cmd == "models") { ai_print_models(first_word(rest), false); return true; }
    if (cmd == "context") {
        let sub: str = first_word(rest);
        let args: str = rest_words(rest);
        if (std.len(sub) == 0 || sub == "show" || sub == "list") {
            let content: str = storage_context_get();
            if (std.len(std.trim(content)) == 0) { std.print("No context saved."); } else { std.print(content); }
            return true;
        }
        if (sub == "clear") { storage_context_clear(); ui_ok("Context cleared."); return true; }
        if (sub == "add") {
            let label: str = first_word(args);
            let text: str = rest_words(args);
            if (std.len(std.trim(text)) == 0) { text = label; label = "note"; }
            if (std.len(std.trim(text)) == 0) { ui_error("Usage: /context add [label] <text>"); return true; }
            storage_context_append(label, text);
            ui_ok("Context added: " + label);
            return true;
        }
        ui_error("Usage: /context show|add|clear");
        return true;
    }
    if (cmd == "permissions" || cmd == "permission") { shell_permission_command(rest); return true; }
    if (cmd == "agent") { shell_agent_command(rest); return true; }
    if (cmd == "model") {
        if (std.len(rest) == 0) {
            std.print(storage_get_active_model());
        } else {
            // support specifying provider/model e.g. openrouter/gpt-4o-mini or just model name
            let m: str = first_word(rest);
            storage_set_active_model(m);
            ui_ok("Active model: " + m);
        }
        return true;
    }
    if (cmd == "env") {
        // /env VAR VALUE  -> set env var for Conductor (persisted to .conductor/env.txt)
        let parts: str = rest;
        let name: str = first_word(parts);
        let val: str = rest_words(parts);
        if (std.len(name) == 0) { ui_error("Usage: /env VAR VALUE"); return true; }
        if (std.len(val) == 0) {
            // print current value from Conductor's stored env file
            let cur: str = storage_env_get(name);
            if (std.len(std.trim(cur)) == 0) { cur = storage_process_env_get(name); }
            ui_kv(name, cur);
            return true;
        }
        // persist in conductor env store
        storage_env_set(name, val);
        ui_ok("Set env: " + name + " (persisted in " + storage_env_path() + "). To export in your shell, run: export " + name + "='" + val + "'");
        return true;
    }
    if (cmd == "init") { command_init_project(); return true; }
    if (cmd == "doctor") { command_doctor(); return true; }
    if (cmd == "run") { shell_run_message(rest); return true; }
    if (cmd == "orchestrate") {
        ui_error("/orchestrate is available as a CLI command: conductor orchestrate <task>");
        return true;
    }
    ui_error("Unknown slash command: /" + cmd);
    return true;
}

fn command_chat() -> i32 {
    storage_init();
    // Cleanup empty sessions on startup
    storage_cleanup_sessions();
    // Create a new session for this Conductor process
    let session_title: str = "interactive " + std.to_str(time.get_time_ms());
    let sid: str = storage_create_session(session_title);
    ui_shell_banner(storage_get_active_agent(), storage_get_active_model());
    ui_kv("session", sid);
    let running: bool = true;
    let empty_reads: i32 = 0;
    while (running) {
        let line: str = std.trim(std.input("conductor> ", 4096));
        if (std.len(line) == 0) {
            empty_reads = empty_reads + 1;
            if (empty_reads >= 3) {
                std.print("No input received; leaving Conductor.");
                running = false;
            }
        } else if (std.starts_with(line, "/")) {
            empty_reads = 0;
            running = shell_handle_command(line);
        } else {
            empty_reads = 0;
            shell_run_message(line);
        }
    }
    return 0;
}

fn command_resume(argc: i32, argv: u64) -> i32 {
    storage_init();
    let id: str = "";
    if (argc >= 3) { id = arg_at(argv, 2); }
    if (std.len(std.trim(id)) == 0) { id = storage_last_session(); }
    if (std.len(std.trim(id)) == 0) { ui_error("No session to resume."); return 1; }
    let rc: i32 = storage_set_active_session(id);
    if (rc == 0) { ui_ok("Resumed session: " + id); return 0; }
    ui_error("Session not found: " + id);
    return rc;
}

fn conductor_dispatch(argc: i32, argv: u64) -> i32 {
    storage_set_home_override(option_value(argc, argv, "--home", ""));
    if (argc <= 1) {
        return command_chat();
    }
    let cmd: str = arg_at(argv, 1);
    if (cmd == "--help" || cmd == "-h" || cmd == "help") {
        ui_help();
        return 0;
    }
    if (cmd == "--version" || cmd == "-v" || cmd == "version") {
        ui_version();
        return 0;
    }
    if (cmd == "chat") { return command_chat(); }
    if (cmd == "run" || cmd == "prompt") { return command_run(argc, argv); }
    if (cmd == "orchestrate" || cmd == "plan") { return command_orchestrate(argc, argv); }
    if (cmd == "resume") { return command_resume(argc, argv); }
    if (cmd == "models") { return command_models(argc, argv); }
    if (cmd == "providers") { return command_providers(argc, argv); }
    if (cmd == "agent") { return command_agent(argc, argv); }
    if (cmd == "permission" || cmd == "permissions") { return command_permission(argc, argv); }
    if (cmd == "skill" || cmd == "skills") { return command_skill(argc, argv); }
    if (cmd == "mcp") { return command_mcp(argc, argv); }
    if (cmd == "control") { return command_control(argc, argv); }
    if (cmd == "session") { return command_session(argc, argv); }
    if (cmd == "context") { return command_context(argc, argv); }
    if (cmd == "env") { return command_env(argc, argv); }
    if (cmd == "config") { return command_config(argc, argv); }
    if (cmd == "stats") { return command_stats(); }
    if (cmd == "status") { return command_status(); }
    if (cmd == "tools") { return command_tools(); }
    if (cmd == "doctor") { return command_doctor(); }
    if (cmd == "init") { return command_init_project(); }
    if (cmd == "export") { return command_export(argc, argv); }
    if (cmd == "import") { return command_import(argc, argv); }
    if (cmd == "serve") { return command_serve(argc, argv); }
    if (cmd == "generate") { return command_generate(); }
    if (cmd == "remote" || cmd == "attach") { return command_remote(); }
    if (cmd == "tool") { return command_tool(argc, argv); }
    ui_error("Unknown command: " + cmd);
    std.print("Run 'conductor help' for usage.");
    return 1;
}
